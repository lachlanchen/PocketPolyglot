{
  "schema_version": 1,
  "task_family": "incremental_english_modern_japanese_overlay",
  "book_id": "genji-modern",
  "chunk_id": "genji-modern-chunk-0186",
  "units": [
    {
      "paragraph_id": "genji-modern-p00186",
      "unit_index": 1,
      "source_text": "到底是个才女，答诗这么快。”",
      "en": [
        {
          "t": "She really is a talented woman, answering a poem so quickly.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p00186",
      "unit_index": 2,
      "source_text": "他不慌不忙地侃侃而谈。",
      "en": [
        {
          "t": "He spoke on calmly and fluently, without the least hurry.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p00186",
      "unit_index": 3,
      "source_text": "源氏公子等都觉得稀奇，对他说道：“你撒谎！”",
      "en": [
        {
          "t": "Prince Genji and the others all found it remarkable and said to him, \"You are lying!\"",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p00186",
      "unit_index": 4,
      "source_text": "大家笑起来。",
      "en": [
        {
          "t": "Everyone burst out laughing.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p00186",
      "unit_index": 5,
      "source_text": "有的嫌恶他：“哪有这等女子？",
      "en": [
        {
          "t": "Some were disgusted with him and said, \"Where could there be such a woman?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p00186",
      "unit_index": 6,
      "source_text": "还不如乖乖地和鬼作伴吧。",
      "en": [
        {
          "t": "You would be better off quietly keeping company with demons.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p00186",
      "unit_index": 7,
      "source_text": "真令人作呕呢！”",
      "en": [
        {
          "t": "It is truly sickening!\"",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p00186",
      "unit_index": 8,
      "source_text": "有的怪他：“这简直不成话！”",
      "en": [
        {
          "t": "Some reproached him, saying, \"This is simply outrageous!\"",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p00186",
      "unit_index": 9,
      "source_text": "有的责备他：“再讲些好听一点的话儿吧！”",
      "en": [
        {
          "t": "Some scolded him, saying, \"Tell us something a little more pleasant!\"",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p00186",
      "unit_index": 10,
      "source_text": "式部丞说：“再好听的没有了。”",
      "en": [
        {
          "t": "The Shikibu no Jo said, \"There is nothing more pleasant than this.\"",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p00186",
      "unit_index": 11,
      "source_text": "说着就溜走了。",
      "en": [
        {
          "t": "With that, he slipped away.",
          "g": "predicate"
        }
      ]
    }
  ]
}
