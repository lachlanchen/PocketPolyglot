  "units": [
    {
      "paragraph_id": "genji-modern-p01560",
      "unit_index": 1,
      "source_text": " 此诗系菅公所作。",
      "en": [
        {
          "t": "This poem was composed by Lord Kan.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p01560",
      "unit_index": 2,
      "source_text": "菅公即菅原道真，乃著名汉学家。",
      "en": [
        {
          "t": "Lord Kan refers to Sugawara no Michizane, a famous scholar of Chinese learning.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p01560",
      "unit_index": 3,
      "source_text": "生年比本书作者略早。",
      "en": [
        {
          "t": "He was born slightly earlier than the author of this book.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p01560",
      "unit_index": 4,
      "source_text": "其诗云：“去年今夜侍清凉，秋思诗篇独断肠。",
      "en": [
        {
          "t": "His poem says: \"Last year on this night I attended at Seiryo-den; my poem of autumn thoughts alone broke my heart.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p01560",
      "unit_index": 5,
      "source_text": "恩赐御衣今在此，捧持每日拜余香。”",
      "en": [
        {
          "t": "The robe graciously bestowed on me is still here now; holding it up, each day I revere its lingering fragrance.\"",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p01560",
      "unit_index": 6,
      "source_text": "见《菅家后草》。",
      "en": [
        {
          "t": "This appears in Kanke Koshu.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p01560",
      "unit_index": 7,
      "source_text": "此乃汉诗照抄，非译文。",
      "en": [
        {
          "t": "This is a direct transcription of the Chinese poem, not a translation.",
          "g": "predicate"
        }
      ]
    }
  ]
