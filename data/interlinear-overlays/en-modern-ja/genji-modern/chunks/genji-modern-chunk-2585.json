      "paragraph_id": "genji-modern-p02585",
      "unit_index": 1,
      "source_text": " 古歌：“寿比苍松，万代青青。",
      "en": [
        {
          "t": "An old poem says: may your life be as long as the evergreen pine, green through ten thousand generations.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p02585",
      "unit_index": 2,
      "source_text": "松下之鹤，托庇千春。”",
      "en": [
        {
          "t": "Like a crane beneath the pine, may you rest under its shelter for a thousand springs.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p02585",
      "unit_index": 3,
      "source_text": "“似彼镜山，屹立江滨。",
      "en": [
        {
          "t": "Like that Mirror Mountain, standing tall by the riverbank.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p02585",
      "unit_index": 4,
      "source_text": "预祝君侯，福寿千春。”",
      "en": [
        {
          "t": "I offer this early wish for my lord: fortune and long life for a thousand springs.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p02585",
      "unit_index": 5,
      "source_text": "均见《古今和歌集》。",
      "en": [
        {
          "t": "Both poems appear in the Kokin Wakashu.",
          "g": "predicate"
        }
      ]
    }
  ]
