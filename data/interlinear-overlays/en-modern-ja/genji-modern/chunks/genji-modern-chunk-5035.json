  "units": [
    {
      "paragraph_id": "genji-modern-p05035",
      "unit_index": 1,
      "source_text": "“洗手川”是寺院门前的川。",
      "en": [
        {
          "t": "The “Washing Hands River” is the river in front of the temple gate.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p05035",
      "unit_index": 2,
      "source_text": "举行祓禊时，将偶像放入川中，让它流去。",
      "en": [
        {
          "t": "When the purification rite is performed, an effigy is placed in the river and allowed to float away.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p05035",
      "unit_index": 3,
      "source_text": "意思是教偶像代受罪过。",
      "en": [
        {
          "t": "The idea is to have the effigy bear the sins in one’s place.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p05035",
      "unit_index": 4,
      "source_text": "所以说“对不起亡姐”。",
      "en": [
        {
          "t": "That is why it says, “I am sorry to my late sister.”",
          "g": "predicate"
        }
      ]
    }
  ]
}
