      "paragraph_id": "genji-modern-p03241",
      "unit_index": 1,
      "source_text": " 应是“此家大轰动”。",
      "en": [
        {
          "t": "It should have been, \"This house is in great turmoil.\"",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03241",
      "unit_index": 2,
      "source_text": "内大臣嫌其不祥，故意改唱。",
      "en": [
        {
          "t": "The Inner Minister disliked it as inauspicious, so he deliberately changed the words as he sang.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03241",
      "unit_index": 3,
      "source_text": "或说：是传讹。",
      "en": [
        {
          "t": "Some say that it was an error handed down in transmission.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03241",
      "unit_index": 4,
      "source_text": "不知孰是。",
      "en": [
        {
          "t": "It is not known which version is correct.",
          "g": "predicate"
        }
      ]
    }
  ]
