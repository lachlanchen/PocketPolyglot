  "units": [
    {
      "paragraph_id": "genji-modern-p01164",
      "unit_index": 1,
      "source_text": "天已经亮了。",
      "en": [
        {
          "t": "Day had already broken.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p01164",
      "unit_index": 2,
      "source_text": "王命妇和弁君苦劝源氏大将早早退出。",
      "en": [
        {
          "t": "Wang Mingfu and Ben no Kimi earnestly urged General Genji to leave at once.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p01164",
      "unit_index": 3,
      "source_text": "此时藤壶皇后几成半死状态。",
      "en": [
        {
          "t": "By then Empress Fujitsubo was almost half dead.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p01164",
      "unit_index": 4,
      "source_text": "源氏大将看了非常难过，便说：“教你知道我这个人还活在世间，实在惭愧之极。",
      "en": [
        {
          "t": "General Genji was deeply distressed to see her and said, \"To let you know that I am still alive in this world fills me with unbearable shame.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p01164",
      "unit_index": 5,
      "source_text": "不如让我就此死去吧！",
      "en": [
        {
          "t": "It would be better to let me die here and now!",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p01164",
      "unit_index": 6,
      "source_text": "但抱恨而死，将为来世造孽，如之奈何？”",
      "en": [
        {
          "t": "But if I die with resentment in my heart, I will create sin for the next life; what am I to do?\"",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p01164",
      "unit_index": 7,
      "source_text": "他说这话时，态度严肃可怕。",
      "en": [
        {
          "t": "As he said this, his manner was solemn and frightening.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p01164",
      "unit_index": 8,
      "source_text": "继而又吟道：",
      "en": [
        {
          "t": "Then he recited another poem:",
          "g": "predicate"
        }
      ]
    }
  ]
}
