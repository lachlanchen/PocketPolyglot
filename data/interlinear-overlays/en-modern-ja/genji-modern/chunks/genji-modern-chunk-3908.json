  "units": [
    {
      "paragraph_id": "genji-modern-p03908",
      "unit_index": 1,
      "source_text": "这经盒还不曾为丧事而涂黑，",
      "en": [
        {
          "t": "This sutra box had not yet been painted black for mourning,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03908",
      "unit_index": 2,
      "source_text": "是老夫人平日惯用的一只螺钿盒，",
      "en": [
        {
          "t": "it was a mother-of-pearl inlaid box that the old lady had used every day,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03908",
      "unit_index": 3,
      "source_text": "是盛诵经布施品用的，",
      "en": [
        {
          "t": "and it had been used to hold offerings for sutra recitations,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03908",
      "unit_index": 4,
      "source_text": "现在公主当作遗念保存着。",
      "en": [
        {
          "t": "now the princess kept it as a memento of her.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03908",
      "unit_index": 5,
      "source_text": "带着玉盒归去，",
      "en": [
        {
          "t": "Going home with the jeweled box in hand,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03908",
      "unit_index": 6,
      "source_text": "形似浦岛太郎。",
      "en": [
        {
          "t": "he looked just like Urashima Taro.",
          "g": "predicate"
        }
      ]
    }
  ]
}
