  "book_id": "genji-modern",
  "chunk_id": "genji-modern-chunk-4734",
  "units": [
    {
      "paragraph_id": "genji-modern-p04734",
      "unit_index": 1,
      "source_text": "总角是头发结成的髻。",
      "en": [
        {
          "t": "Agemaki refers to a topknot made by tying up the hair.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p04734",
      "unit_index": 2,
      "source_text": "此处用以比喻编制流苏。",
      "en": [
        {
          "t": "Here it is used as a metaphor for braiding tassels.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p04734",
      "unit_index": 3,
      "source_text": "又，总角代表少女，根据催马乐《总角》歌云：",
      "en": [
        {
          "t": "Also, agemaki represents a young girl; according to the saibara song Agemaki, the lyrics say:",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p04734",
      "unit_index": 4,
      "source_text": "“总角呀总角！",
      "en": [
        {
          "t": "Agemaki, ah, Agemaki!",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p04734",
      "unit_index": 5,
      "source_text": "请你听我唱：",
      "en": [
        {
          "t": "Please listen to me sing:",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p04734",
      "unit_index": 6,
      "source_text": "你我分开睡，相隔约寻丈。",
      "en": [
        {
          "t": "You and I sleep apart, separated by about a fathom.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p04734",
      "unit_index": 7,
      "source_text": "双方滚拢来，从此长相傍。”",
      "en": [
        {
          "t": "Let us both roll closer together, and from now on stay always side by side.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p04734",
      "unit_index": 8,
      "source_text": "本回题名据此。",
      "en": [
        {
          "t": "The title of this chapter is based on this.",
          "g": "predicate"
        }
      ]
    }
  ]
}
