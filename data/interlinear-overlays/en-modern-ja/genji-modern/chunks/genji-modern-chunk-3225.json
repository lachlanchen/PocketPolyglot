{
  "schema_version": 1,
  "task_family": "incremental_english_modern_japanese_overlay",
  "book_id": "genji-modern",
  "chunk_id": "genji-modern-chunk-3225",
  "units": [
    {
      "paragraph_id": "genji-modern-p03225",
      "unit_index": 1,
      "source_text": "晚风吹下各种各样的红叶来，",
      "en": [
        {
          "t": "The evening wind blew down all kinds of red leaves,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03225",
      "unit_index": 2,
      "source_text": "有的深色，有的浅色，",
      "en": [
        {
          "t": "some dark in color and some pale,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03225",
      "unit_index": 3,
      "source_text": "地上仿佛盖上了锦茵。",
      "en": [
        {
          "t": "so that the ground seemed to be covered with a brocade carpet.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03225",
      "unit_index": 4,
      "source_text": "庭前很像为迎驾而铺饰锦绣的走廊。",
      "en": [
        {
          "t": "The front of the garden looked much like a corridor spread and decorated with brocade to welcome an imperial visit.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03225",
      "unit_index": 5,
      "source_text": "庭中有许多眉清目秀的童子，",
      "en": [
        {
          "t": "In the garden were many clear-featured, handsome boys,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03225",
      "unit_index": 6,
      "source_text": "都是高贵之家的子侄，",
      "en": [
        {
          "t": "all of them sons and nephews of noble families,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03225",
      "unit_index": 7,
      "source_text": "身穿蓝色、红色大礼服，",
      "en": [
        {
          "t": "wearing blue and red ceremonial robes,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03225",
      "unit_index": 8,
      "source_text": "内衬暗红色、淡紫色的衬袍，",
      "en": [
        {
          "t": "with dark red and pale purple underrobes layered beneath,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03225",
      "unit_index": 9,
      "source_text": "都是日常装束，",
      "en": [
        {
          "t": "all of these being their everyday attire,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03225",
      "unit_index": 10,
      "source_text": "头发照常左右分开，",
      "en": [
        {
          "t": "their hair parted to the left and right as usual,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03225",
      "unit_index": 11,
      "source_text": "只在额上加个宝冠。",
      "en": [
        {
          "t": "with only a jeweled crown added at the forehead.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03225",
      "unit_index": 12,
      "source_text": "他们在红叶地上表演种种简短的舞蹈，",
      "en": [
        {
          "t": "They performed various short dances on the ground strewn with red leaves,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03225",
      "unit_index": 13,
      "source_text": "舞罢回进红叶林荫中。",
      "en": [
        {
          "t": "and when the dancing was over, they withdrew again into the shade of the maple grove.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03225",
      "unit_index": 14,
      "source_text": "此景甚美，",
      "en": [
        {
          "t": "The scene was very beautiful,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03225",
      "unit_index": 15,
      "source_text": "令人可惜日色之将暮。",
      "en": [
        {
          "t": "making one regret that the daylight was about to fade.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03225",
      "unit_index": 16,
      "source_text": "此时不令乐队演奏长篇的乐曲，",
      "en": [
        {
          "t": "At this time they did not have the musicians perform any long pieces,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03225",
      "unit_index": 17,
      "source_text": "但在堂上合奏弦管。",
      "en": [
        {
          "t": "but only had strings and pipes played together in the hall.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03225",
      "unit_index": 18,
      "source_text": "书司所藏的琴都取来了。",
      "en": [
        {
          "t": "All the zithers kept by the Office of Books were brought out.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03225",
      "unit_index": 19,
      "source_text": "兴酣之时，",
      "en": [
        {
          "t": "When the enjoyment was at its height,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03225",
      "unit_index": 20,
      "source_text": "冷泉帝、朱雀院与源氏主人御前都呈上琴来。",
      "en": [
        {
          "t": "zithers were presented before Emperor Reizei, the Retired Emperor Suzaku, and their host Genji.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03225",
      "unit_index": 21,
      "source_text": "有名的和琴“宇陀法师”，",
      "en": [
        {
          "t": "The famous wagon zither called Uda Hoshi,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03225",
      "unit_index": 22,
      "source_text": "声音并未改变，",
      "en": [
        {
          "t": "had not changed in tone,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03225",
      "unit_index": 23,
      "source_text": "但在朱雀院听来，",
      "en": [
        {
          "t": "but to the ears of the Retired Emperor Suzaku,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03225",
      "unit_index": 24,
      "source_text": "今日特别动人，",
      "en": [
        {
          "t": "it sounded especially moving today,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p03225",
      "unit_index": 25,
      "source_text": "便吟诗云：",
      "en": [
        {
          "t": "and so he chanted a poem:",
          "g": "predicate"
        }
      ]
    }
  ]
}
