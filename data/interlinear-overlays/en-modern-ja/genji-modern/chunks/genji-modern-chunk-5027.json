      ]
    },
    {
      "paragraph_id": "genji-modern-p05027",
      "unit_index": 2,
      "source_text": "只恨宿命穷，此身长落寞。”",
      "en": [
        {
          "t": "I only lament that my fate has run out, and that this body will remain lonely for a long time.",
          "g": "predicate"
