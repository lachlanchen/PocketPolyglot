  "units": [
    {
      "paragraph_id": "genji-modern-p01251",
      "unit_index": 1,
      "source_text": "我就此衰朽了！”",
      "en": [
        {
          "t": "I shall wither away just like this!",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p01251",
      "unit_index": 2,
      "source_text": "他醉态可掬，故意开玩笑。",
      "en": [
        {
          "t": "He looked charmingly drunk and deliberately made a joke.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p01251",
      "unit_index": 3,
      "source_text": "中将强责以干杯。",
      "en": [
        {
          "t": "The lieutenant general pressed him firmly to drain his cup.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p01251",
      "unit_index": 4,
      "source_text": "此时众人所咏诗歌甚多，但都是贯之曾谏诫的那种“欠考虑”的乘兴率尔之作，",
      "en": [
        {
          "t": "At this time the poems everyone composed were numerous, but they were all impulsive, spur-of-the-moment pieces of the sort Tsurayuki had once warned against as lacking thought,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p01251",
      "unit_index": 5,
      "source_text": "若一一记载，未免无聊。",
      "en": [
        {
          "t": "and if each one were recorded, it would inevitably be tedious.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p01251",
      "unit_index": 6,
      "source_text": "为避免烦冗，一概从略。",
      "en": [
        {
          "t": "To avoid needless verbosity, they are all omitted.",
          "g": "predicate"
        }
      ]
    }
  ]
}
