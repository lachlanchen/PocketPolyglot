  "units": [
    {
      "paragraph_id": "genji-modern-p04632",
      "unit_index": 1,
      "source_text": "此诗含有威胁之意。",
      "en": [
        {
          "t": "This poem contained a threatening implication.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p04632",
      "unit_index": 2,
      "source_text": "大女公子想起自己和妹妹都曾被薰君当面看见过，",
      "en": [
        {
          "t": "The elder princess remembered that both she and her younger sister had once been seen face to face by Lord Kaoru,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p04632",
      "unit_index": 3,
      "source_text": "看了这诗更觉羞耻，",
      "en": [
        {
          "t": "and after reading this poem she felt even more ashamed,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p04632",
      "unit_index": 4,
      "source_text": "不知复诗如何写法，心甚忧烦。",
      "en": [
        {
          "t": "not knowing how to compose a reply poem, and her heart was deeply troubled.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p04632",
      "unit_index": 5,
      "source_text": "此时送信来的几个使者都已逃匿，",
      "en": [
        {
          "t": "By this time the several messengers who had brought the letter had all run off and hidden themselves,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p04632",
      "unit_index": 6,
      "source_text": "她只得召唤一个拙陋的下仆过来，",
      "en": [
        {
          "t": "so she had no choice but to summon a clumsy, lowly servant,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p04632",
      "unit_index": 7,
      "source_text": "把复诗交付了他。",
      "en": [
        {
          "t": "and entrusted the reply poem to him.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "genji-modern-p04632",
      "unit_index": 8,
      "source_text": "诗曰：",
      "en": [
        {
          "t": "The poem said:",
          "g": "predicate"
        }
      ]
