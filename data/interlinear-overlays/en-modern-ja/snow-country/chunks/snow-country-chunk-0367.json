    {
      "paragraph_id": "snow-country-zh-p00367",
      "unit_index": 2,
      "source_text": "现在几点钟啦？”",
      "en": [
        {
          "t": "What time is it now?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p00367",
      "unit_index": 3,
      "source_text": "按摩女胳肢窝里夹着一根竹杖，",
      "en": [
        {
          "t": "The masseuse held a bamboo cane under her arm,",
          "g": "predicate"
        }
      ]
