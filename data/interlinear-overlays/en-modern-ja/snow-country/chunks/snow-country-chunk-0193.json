    {
      "paragraph_id": "snow-country-zh-p00193",
      "unit_index": 1,
      "source_text": "“没醉嘛。嗯，谁醉啦？",
      "en": [
        {
          "t": "I am not drunk. Hmm, who is drunk?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p00193",
      "unit_index": 2,
      "source_text": "难受，我只觉得难受。",
      "en": [
        {
          "t": "I feel awful, that is all I feel.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p00193",
      "unit_index": 3,
      "source_text": "脑子清醒着呐。",
      "en": [
        {
          "t": "My head is perfectly clear.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p00193",
      "unit_index": 4,
      "source_text": "啊，想喝水。",
      "en": [
        {
          "t": "Ah, I want some water.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p00193",
      "unit_index": 5,
      "source_text": "坏在掺威士忌喝。",
      "en": [
        {
          "t": "The trouble was mixing in whisky when I drank.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p00193",
      "unit_index": 6,
      "source_text": "那玩意儿上脑，头痛得厉害。",
      "en": [
        {
          "t": "That stuff goes straight to my head, and it hurts terribly.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p00193",
      "unit_index": 7,
      "source_text": "那帮子人买的是廉价酒，我不知道……”",
      "en": [
        {
          "t": "They had bought cheap liquor, and I did not know it...",
          "g": "predicate"
        }
      ]
    }
  ]
