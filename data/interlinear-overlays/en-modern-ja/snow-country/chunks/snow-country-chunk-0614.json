    {
      "paragraph_id": "snow-country-zh-p00614",
      "unit_index": 1,
      "source_text": "“什么日记，我已经不记了。",
      "en": [
        {
          "t": "Diary? I do not keep one anymore.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p00614",
      "unit_index": 2,
      "source_text": "我要把它全烧掉。”",
      "en": [
        {
          "t": "I am going to burn it all.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p00614",
      "unit_index": 3,
      "source_text": "驹子喃喃自语，无缘无故地脸红起来了。",
      "en": [
        {
          "t": "Komako murmured to herself, and for no reason her face began to blush.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p00614",
      "unit_index": 4,
      "source_text": "“啊，你是个老实人。",
      "en": [
        {
          "t": "Ah, you are an honest person.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p00614",
      "unit_index": 5,
      "source_text": "要真是老实人的话，我可以把日记全都给你。",
      "en": [
        {
          "t": "If you really are honest, I could give you all of my diaries.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p00614",
      "unit_index": 6,
      "source_text": "你不会笑话我吧。",
      "en": [
        {
          "t": "You would not laugh at me, would you?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p00614",
      "unit_index": 7,
      "source_text": "我认为你是个老实人。”",
      "en": [
        {
          "t": "I think you are an honest person.",
          "g": "predicate"
        }
      ]
    }
  ]
