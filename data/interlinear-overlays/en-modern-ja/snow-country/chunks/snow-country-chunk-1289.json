  "units": [
    {
      "paragraph_id": "snow-country-zh-p01289",
      "unit_index": 1,
      "source_text": "火势燃得更旺了。",
      "en": [
        {
          "t": "The fire was burning even more fiercely.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p01289",
      "unit_index": 2,
      "source_text": "从高处望下去，辽阔的星空下，大火宛如一场游戏，无声无息。",
      "en": [
        {
          "t": "Looking down from above, beneath the vast starry sky, the great fire seemed like a game, silent and soundless.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p01289",
      "unit_index": 3,
      "source_text": "尽管如此，她却感到恐惧。有如听见一种猛烈的火焰声逼将过来。",
      "en": [
        {
          "t": "Even so, she felt afraid, as though she could hear the roar of fierce flames pressing closer.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p01289",
      "unit_index": 4,
      "source_text": "岛村抱住了驹子。",
      "en": [
        {
          "t": "Shimamura held Komako in his arms.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p01289",
      "unit_index": 5,
      "source_text": "“没什么可怕的。”",
      "en": [
        {
          "t": "There is nothing to be afraid of.",
          "g": "predicate"
        }
      ]
    }
  ]
}
