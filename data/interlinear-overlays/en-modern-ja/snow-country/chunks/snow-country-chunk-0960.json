          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p00960",
      "unit_index": 2,
      "source_text": "本来有六场宴会，只转了四场。",
      "en": [
        {
          "t": "There were supposed to be six parties, but I only made the rounds to four.",
          "g": "predicate"
        }
