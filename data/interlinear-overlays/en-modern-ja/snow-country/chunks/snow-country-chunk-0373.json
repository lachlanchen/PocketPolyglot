  "units": [
    {
      "paragraph_id": "snow-country-zh-p00373",
      "unit_index": 1,
      "source_text": "“要是下雨，女儿来接。",
      "en": [
        {
          "t": "If it rains, my daughter comes to meet me.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p00373",
      "unit_index": 2,
      "source_text": "晚上给村里人按摩，不会上这里来。",
      "en": [
        {
          "t": "At night I go massage people in the village, so I do not come up here.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p00373",
      "unit_index": 3,
      "source_text": "客栈女侍常揶揄说，我老头子不让我出来，真没法子啊！”",
      "en": [
        {
          "t": "The maids at the inn are always teasing me, saying my old man will not let me out, and there is nothing I can do about it!",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p00373",
      "unit_index": 4,
      "source_text": "“孩子都大了？”",
      "en": [
        {
          "t": "Are all your children grown up now?",
          "g": "predicate"
        }
      ]
    }
  ]
}
