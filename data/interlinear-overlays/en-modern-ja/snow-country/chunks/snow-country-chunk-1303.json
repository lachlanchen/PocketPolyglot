      "paragraph_id": "snow-country-zh-p01303",
      "unit_index": 1,
      "source_text": "驹子好像追赶着伙计似地走下石磴。",
      "en": [
        {
          "t": "Komako went down the stone steps as if chasing after the attendant.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p01303",
      "unit_index": 2,
      "source_text": "后来下楼的人都跑到她的前头去了。",
      "en": [
        {
          "t": "The people who came down after her all ran ahead of her.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p01303",
      "unit_index": 3,
      "source_text": "她不由自主地跟着跑了起来。",
      "en": [
        {
          "t": "Without meaning to, she began running after them.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p01303",
      "unit_index": 4,
      "source_text": "岛村也随后跟上。",
      "en": [
        {
          "t": "Shimamura followed along after her too.",
          "g": "predicate"
        }
      ]
    }
  ]
}
