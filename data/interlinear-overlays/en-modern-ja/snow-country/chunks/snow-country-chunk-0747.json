    {
      "paragraph_id": "snow-country-zh-p00747",
      "unit_index": 1,
      "source_text": "“既然了解，那你说说看。喏，你说说看。”",
      "en": [
        {
          "t": "“If you understand, then tell me. Come on, tell me.”",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p00747",
      "unit_index": 2,
      "source_text": "驹子突然带着追问的口气说，",
      "en": [
        {
          "t": "Komako suddenly said in a pressing, questioning tone,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p00747",
      "unit_index": 3,
      "source_text": "“你瞧，说不出来了吧。",
      "en": [
        {
          "t": "“See, you cannot say it, can you.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p00747",
      "unit_index": 4,
      "source_text": "尽撒谎。你这个人呀，挥霍无度，大大咧咧。",
      "en": [
        {
          "t": "All you do is lie. You are extravagant and careless.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p00747",
      "unit_index": 5,
      "source_text": "你是不会了解我的。”",
      "en": [
        {
          "t": "You will never understand me.”",
          "g": "predicate"
        }
      ]
    }
  ]
}
