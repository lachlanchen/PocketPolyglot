  "units": [
    {
      "paragraph_id": "snow-country-zh-p00111",
      "unit_index": 1,
      "source_text": "“年轻就可以。",
      "en": [
        {
          "t": "Being young is enough.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p00111",
      "unit_index": 2,
      "source_text": "年轻姑娘嘛，各方面都会少出差错。",
      "en": [
        {
          "t": "With a young girl, you see, there are fewer mistakes in every respect.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p00111",
      "unit_index": 3,
      "source_text": "不要唠叨得令人讨厌就行。",
      "en": [
        {
          "t": "It is enough if she does not chatter on until she becomes annoying.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p00111",
      "unit_index": 4,
      "source_text": "迷糊一点也不要紧，洁净就行了。",
      "en": [
        {
          "t": "It does not matter if she is a little absentminded, as long as she is clean.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "snow-country-zh-p00111",
      "unit_index": 5,
      "source_text": "等我想聊天的时候，就去找你。”",
      "en": [
        {
          "t": "When I feel like talking, I will come to you.",
          "g": "predicate"
        }
      ]
    }
  ]
}
