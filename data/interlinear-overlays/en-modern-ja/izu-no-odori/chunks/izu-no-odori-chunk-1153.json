    {
      "paragraph_id": "izu-no-odori-p01153",
      "unit_index": 3,
      "source_text": "我对自己的胡思乱想感到恼火。",
      "en": [
        {
          "t": "I felt annoyed by my own wild, rambling thoughts.",
          "g": "predicate"
        }
