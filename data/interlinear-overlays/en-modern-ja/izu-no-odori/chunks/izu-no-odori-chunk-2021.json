  "units": [
    {
      "paragraph_id": "izu-no-odori-p02021",
      "unit_index": 1,
      "source_text": "“我收下了。",
      "en": [
        {
          "t": "I have accepted it.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p02021",
      "unit_index": 2,
      "source_text": "我可以收下吧。”",
      "en": [
        {
          "t": "It is all right for me to accept it, isn't it?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p02021",
      "unit_index": 3,
      "source_text": "夫人一边解开丈夫衬衫的纽扣，一边又说：“",
      "en": [
        {
          "t": "As the lady unbuttoned her husband's shirt, she went on, \"",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p02021",
      "unit_index": 4,
      "source_text": "那小姐活像洁白的丁香花那样清爽纯洁。",
      "en": [
        {
          "t": "That young lady was as fresh and pure as a white lilac blossom.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p02021",
      "unit_index": 5,
      "source_text": "我心想，倘若她是你的情人呢……",
      "en": [
        {
          "t": "I thought to myself, what if she were your lover...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p02021",
      "unit_index": 6,
      "source_text": "记得咱们不是约好了吗？",
      "en": [
        {
          "t": "Don't you remember that we made a promise?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p02021",
      "unit_index": 7,
      "source_text": "今后三年内倘若不生孩子，你可以纳妾。”",
      "en": [
        {
          "t": "If we do not have a child within the next three years, you may take a concubine.\"",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p02021",
      "unit_index": 8,
      "source_text": "（王八先生。）",
      "en": [
        {
          "t": "(You rotten man.)",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p02021",
      "unit_index": 9,
      "source_text": "“我们家的小宠犬也做父亲了呀。”",
      "en": [
        {
          "t": "\"Even our little pet dog has become a father.\"",
          "g": "predicate"
        }
      ]
    }
  ]
}
