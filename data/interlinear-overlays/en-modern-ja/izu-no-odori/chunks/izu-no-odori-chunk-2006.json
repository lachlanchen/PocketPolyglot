  "units": [
    {
      "paragraph_id": "izu-no-odori-p02006",
      "unit_index": 1,
      "source_text": "“颠倒过来啦。",
      "en": [
        {
          "t": "It is the other way around.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p02006",
      "unit_index": 2,
      "source_text": "研究顺畅的时候，回家就高兴。",
      "en": [
        {
          "t": "When your research is going smoothly, you are happy to come home.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p02006",
      "unit_index": 3,
      "source_text": "感到寂寞的是你吧？",
      "en": [
        {
          "t": "You are the one who feels lonely, aren't you?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p02006",
      "unit_index": 4,
      "source_text": "嗯，不过，嗨！",
      "en": [
        {
          "t": "Yes, but, well!",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p02006",
      "unit_index": 5,
      "source_text": "就算我感到寂寞吧。",
      "en": [
        {
          "t": "Let us say I do feel lonely.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p02006",
      "unit_index": 6,
      "source_text": "且说想到寂寞嘛，倒真是很寂寞啊！",
      "en": [
        {
          "t": "But when I think about loneliness, it really is terribly lonely!",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p02006",
      "unit_index": 7,
      "source_text": "为人妻子这种角色，即使感觉到丈夫极其寂寞，也只好沉默不语。”",
      "en": [
        {
          "t": "In the role of a wife, even if she senses that her husband is deeply lonely, she has no choice but to keep silent.",
          "g": "predicate"
        }
      ]
    }
  ]
}
