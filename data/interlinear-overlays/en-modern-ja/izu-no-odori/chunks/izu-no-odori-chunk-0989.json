  "units": [
    {
      "paragraph_id": "izu-no-odori-p00989",
      "unit_index": 1,
      "source_text": "“算了，让他带她一个人去不好吗？”",
      "en": [
        {
          "t": "Never mind, wouldn't it be all right to let him take her by herself?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00989",
      "unit_index": 2,
      "source_text": "荣吉插话说。",
      "en": [
        {
          "t": "Eikichi broke in and said.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00989",
      "unit_index": 3,
      "source_text": "阿妈好像不应允。",
      "en": [
        {
          "t": "The mother seemed unwilling to allow it.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00989",
      "unit_index": 4,
      "source_text": "为什么不能带她一个人去呢？",
      "en": [
        {
          "t": "Why could he not take her by herself?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00989",
      "unit_index": 5,
      "source_text": "我觉得奇怪。",
      "en": [
        {
          "t": "I found it strange.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00989",
      "unit_index": 6,
      "source_text": "我要迈出大门时，舞女抚摸着小狗的头。",
      "en": [
        {
          "t": "As I was about to step out through the front door, the dancer was stroking the puppy's head.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00989",
      "unit_index": 7,
      "source_text": "她显得很淡漠，我没敢搭话。",
      "en": [
        {
          "t": "She seemed very distant, and I did not dare speak to her.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00989",
      "unit_index": 8,
      "source_text": "她仿佛连抬头望我的勇气也没有了。",
      "en": [
        {
          "t": "It was as if she no longer even had the courage to raise her head and look at me.",
          "g": "predicate"
        }
      ]
    }
  ]
