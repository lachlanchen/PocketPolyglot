  "units": [
    {
      "paragraph_id": "izu-no-odori-p00184",
      "unit_index": 1,
      "source_text": "“前些日子，他就说有事商量，要请西方寺的和尚来一趟。",
      "en": [
        {
          "t": "A few days ago, he said he had something to discuss and wanted to ask the monk from Saihoji Temple to come over.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00184",
      "unit_index": 2,
      "source_text": "我照例说，人家不在、不在，他生气了。”",
      "en": [
        {
          "t": "As usual, I told him, he is not here, he is not here, and he got angry.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00184",
      "unit_index": 3,
      "source_text": "美代这样对我说。",
      "en": [
        {
          "t": "Miyo said this to me.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00184",
      "unit_index": 4,
      "source_text": "她打算等祖父把话说完，解释一下祖父不悦的原因。",
      "en": [
        {
          "t": "She intended to wait until Grandfather had finished speaking, then explain a little why he was displeased.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00184",
      "unit_index": 5,
      "source_text": "我才生气呢。",
      "en": [
        {
          "t": "I was the one who should have been angry.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00184",
      "unit_index": 6,
      "source_text": "我同情祖父。",
      "en": [
        {
          "t": "I sympathized with Grandfather.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00184",
      "unit_index": 7,
      "source_text": "为什么要去欺骗他呢？",
      "en": [
        {
          "t": "Why did they have to deceive him?",
          "g": "predicate"
        }
      ]
    }
  ]
}
