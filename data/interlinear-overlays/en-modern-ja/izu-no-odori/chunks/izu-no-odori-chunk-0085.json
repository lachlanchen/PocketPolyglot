    {
      "paragraph_id": "izu-no-odori-p00085",
      "unit_index": 1,
      "source_text": "“是么，两次？",
      "en": [
        {
          "t": "Is that so, twice?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00085",
      "unit_index": 2,
      "source_text": "十二点和三点起来，是你帮他接的吧？",
      "en": [
        {
          "t": "You got up at midnight and at three and helped take care of him, didn't you?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00085",
      "unit_index": 3,
      "source_text": "年纪轻轻，真可怜啊。",
      "en": [
        {
          "t": "So young, it really is pitiful.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00085",
      "unit_index": 4,
      "source_text": "就看作是给祖父报恩吧……",
      "en": [
        {
          "t": "Think of it as repaying your grandfather's kindness...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00085",
      "unit_index": 5,
      "source_text": "我家有人生孩子，我不能在这儿留宿。",
      "en": [
        {
          "t": "Someone at my house is having a baby, so I cannot stay here overnight.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00085",
      "unit_index": 6,
      "source_text": "阿菊只会生，不会养。”",
      "en": [
        {
          "t": "Akiku can give birth, but she cannot raise the child.\"",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00085",
      "unit_index": 7,
      "source_text": "（阿菊是美代的儿媳妇，那时生头一胎。）",
      "en": [
        {
          "t": "(Akiku was Miyo's daughter-in-law, and at that time she was giving birth to her first child.)",
          "g": "predicate"
        }
      ]
    }
  ]
