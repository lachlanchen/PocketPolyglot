  "units": [
    {
      "paragraph_id": "izu-no-odori-p01983",
      "unit_index": 1,
      "source_text": "“请您放宽心坐着。",
      "en": [
        {
          "t": "Please sit at ease.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p01983",
      "unit_index": 2,
      "source_text": "哎哟！",
      "en": [
        {
          "t": "Oh dear!",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p01983",
      "unit_index": 3,
      "source_text": "也没给换茶。”",
      "en": [
        {
          "t": "I did not even change the tea for you.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p01983",
      "unit_index": 4,
      "source_text": "夫人感到羞愧，活像自己被剥成赤身裸体般羞耻，",
      "en": [
        {
          "t": "The lady felt ashamed, as mortified as if she herself had been stripped naked,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p01983",
      "unit_index": 5,
      "source_text": "为了逃避现状，她旋即抱起小宠犬离开了房间。",
      "en": [
        {
          "t": "and to escape the situation, she immediately picked up the little pet dog and left the room.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p01983",
      "unit_index": 6,
      "source_text": "但是，当她把身后的房门关上，",
      "en": [
        {
          "t": "But when she closed the room door behind her,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p01983",
      "unit_index": 7,
      "source_text": "粗暴地把公狗往走廊上抛出手的瞬间，",
      "en": [
        {
          "t": "and at the instant she roughly flung the male dog from her hands into the corridor,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p01983",
      "unit_index": 8,
      "source_text": "长时间压抑在内心的笑声顿时直往上涌，",
      "en": [
        {
          "t": "the laughter she had kept suppressed in her heart for so long suddenly surged up,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p01983",
      "unit_index": 9,
      "source_text": "她爽朗地笑出声来。",
      "en": [
        {
          "t": "and she burst out laughing brightly.",
          "g": "predicate"
        }
      ]
    }
  ]
}
