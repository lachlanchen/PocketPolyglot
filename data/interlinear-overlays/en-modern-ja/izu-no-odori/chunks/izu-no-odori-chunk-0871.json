      "paragraph_id": "izu-no-odori-p00871",
      "unit_index": 1,
      "source_text": "“是吗？",
      "en": [
        {
          "t": "Is that so?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00871",
      "unit_index": 2,
      "source_text": "那大姑娘是我老婆，她比你小一岁，十九岁了。",
      "en": [
        {
          "t": "That older girl is my wife; she is one year younger than you, nineteen years old.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00871",
      "unit_index": 3,
      "source_text": "第二个孩子在旅途上早产，活了一周就断气了。",
      "en": [
        {
          "t": "Our second child was born prematurely on the road and died after living for a week.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00871",
      "unit_index": 4,
      "source_text": "我老婆的身子还没完全恢复过来呢。",
      "en": [
        {
          "t": "My wife has not fully recovered yet.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00871",
      "unit_index": 5,
      "source_text": "那位是我老婆的阿妈。",
      "en": [
        {
          "t": "That woman is my wife's mother.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00871",
      "unit_index": 6,
      "source_text": "舞女是我妹妹。”",
      "en": [
        {
          "t": "The dancing girl is my younger sister.",
          "g": "predicate"
        }
      ]
    }
  ]
