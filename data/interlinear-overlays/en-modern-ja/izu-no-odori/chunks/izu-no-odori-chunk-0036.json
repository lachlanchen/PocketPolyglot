  "units": [
    {
      "paragraph_id": "izu-no-odori-p00036",
      "unit_index": 1,
      "source_text": "水烧开了，我让他喝了茶。",
      "en": [
        {
          "t": "When the water boiled, I let him drink some tea.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00036",
      "unit_index": 2,
      "source_text": "是粗茶。",
      "en": [
        {
          "t": "It was coarse, plain tea.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00036",
      "unit_index": 3,
      "source_text": "我无微不至地侍候他，给他喝茶。",
      "en": [
        {
          "t": "I tended to him with the greatest care and gave him tea to drink.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00036",
      "unit_index": 4,
      "source_text": "他一副可怜的模样：",
      "en": [
        {
          "t": "He made a pitiful sight:",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00036",
      "unit_index": 5,
      "source_text": "瘦削干瘪的脸，只剩几缕白发的脑壳，",
      "en": [
        {
          "t": "a gaunt, withered face, a head with only a few wisps of white hair left,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00036",
      "unit_index": 6,
      "source_text": "不住颤抖的皮包骨的手，",
      "en": [
        {
          "t": "hands that were nothing but skin and bone, trembling without stop,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00036",
      "unit_index": 7,
      "source_text": "咕嘟咕嘟地每喝一口就动一动的鹤颈般的喉核。",
      "en": [
        {
          "t": "and an Adam's apple like a crane's neck, bobbing with every gulp he took.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p00036",
      "unit_index": 8,
      "source_text": "他一连喝了三杯茶。",
      "en": [
        {
          "t": "He drank three cups of tea in succession.",
          "g": "predicate"
        }
      ]
    }
  ]
}
