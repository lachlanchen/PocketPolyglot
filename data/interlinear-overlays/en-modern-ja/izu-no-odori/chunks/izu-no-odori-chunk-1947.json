  "units": [
    {
      "paragraph_id": "izu-no-odori-p01947",
      "unit_index": 1,
      "source_text": "“哎哟！”（修指甲。）",
      "en": [
        {
          "t": "“Oh!” (Doing her nails.)",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p01947",
      "unit_index": 2,
      "source_text": "夫人活像想起不知从哪里掉下来的梦幻似的。",
      "en": [
        {
          "t": "The lady looked just as though she had remembered some dream that had fallen from who knew where.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p01947",
      "unit_index": 3,
      "source_text": "（就连剪子也是妇产科的器械。",
      "en": [
        {
          "t": "(Even scissors are instruments of obstetrics and gynecology.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p01947",
      "unit_index": 4,
      "source_text": "要说剪子的种类嘛，得数妇产科的器械种类特别多。",
      "en": [
        {
          "t": "When it comes to kinds of scissors, the instruments of obstetrics and gynecology have an especially great variety.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p01947",
      "unit_index": 5,
      "source_text": "修指甲的剪刀和妇产科的内格雷剪子状穿颅器。",
      "en": [
        {
          "t": "Nail scissors, and the Naegele scissor-shaped perforator used in obstetrics and gynecology.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p01947",
      "unit_index": 6,
      "source_text": "穿颅术。",
      "en": [
        {
          "t": "Craniotomy.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p01947",
      "unit_index": 7,
      "source_text": "胎儿粉碎的脑髓。",
      "en": [
        {
          "t": "The crushed brain matter of a fetus.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p01947",
      "unit_index": 8,
      "source_text": "啊！我是——圣诞节。",
      "en": [
        {
          "t": "Ah! I am Christmas.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p01947",
      "unit_index": 9,
      "source_text": "小姐那双眼，真像男孩儿的眼睛，未经化妆的美丽的瞳眸。",
      "en": [
        {
          "t": "The young lady’s eyes were truly like a boy’s eyes, beautiful pupils untouched by makeup.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p01947",
      "unit_index": 10,
      "source_text": "丈夫的近视眼镜。",
      "en": [
        {
          "t": "Her husband’s nearsighted glasses.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p01947",
      "unit_index": 11,
      "source_text": "倘若米洛斯的维纳斯戴上近视眼镜……",
      "en": [
        {
          "t": "If the Venus de Milo were to put on nearsighted glasses...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p01947",
      "unit_index": 12,
      "source_text": "先人哟！",
      "en": [
        {
          "t": "O ancestors!",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p01947",
      "unit_index": 13,
      "source_text": "汝等纵令涂抹眼圈以显大，汝等的装束亦徒然。",
      "en": [
        {
          "t": "Even if you paint around your eyes to make them look larger, your adornment is still in vain.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p01947",
      "unit_index": 14,
      "source_text": "故乡海港的天主教堂。",
      "en": [
        {
          "t": "The Catholic church at the harbor of my hometown.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "izu-no-odori-p01947",
      "unit_index": 15,
      "source_text": "父亲医院的产科手术的气味。）",
      "en": [
        {
          "t": "The smell of obstetric surgery at my father’s hospital.)",
          "g": "predicate"
        }
      ]
    }
  ]
}
