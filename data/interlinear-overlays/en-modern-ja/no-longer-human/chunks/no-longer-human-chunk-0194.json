{
  "schema_version": 1,
  "task_family": "incremental_english_modern_japanese_overlay",
  "book_id": "no-longer-human",
  "chunk_id": "no-longer-human-chunk-0194",
  "units": [
    {
      "paragraph_id": "no-longer-human-zh-p00194",
      "unit_index": 1,
      "source_text": "我們拉鉤吧。",
      "en": [
        {
          "t": "Let's make a pinky promise.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "no-longer-human-zh-p00194",
      "unit_index": 2,
      "source_text": "我一定要戒酒。」",
      "en": [
        {
          "t": "I will definitely give up drinking.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "no-longer-human-zh-p00194",
      "unit_index": 3,
      "source_text": "可翌日午後，我又喝起了酒。",
      "en": [
        {
          "t": "But the next afternoon, I started drinking again.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "no-longer-human-zh-p00194",
      "unit_index": 4,
      "source_text": "傍晚時分，我搖搖晃晃地走出來，暈乎乎地站在良子的店門前。",
      "en": [
        {
          "t": "Toward evening, I staggered outside and stood dazed in front of Yoshiko's shop.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "no-longer-human-zh-p00194",
      "unit_index": 5,
      "source_text": "「良子，對不起啊，我又喝酒了。」",
      "en": [
        {
          "t": "Yoshiko, I'm sorry. I drank again.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "no-longer-human-zh-p00194",
      "unit_index": 6,
      "source_text": "「哎呀，真討厭，故意裝成喝醉的樣子。」",
      "en": [
        {
          "t": "Oh, how awful, pretending to be drunk like that.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "no-longer-human-zh-p00194",
      "unit_index": 7,
      "source_text": "我為之一驚，一下子從醉意中清醒過來。",
      "en": [
        {
          "t": "That startled me, and I sobered up all at once.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "no-longer-human-zh-p00194",
      "unit_index": 8,
      "source_text": "「不，是真的。",
      "en": [
        {
          "t": "No, it's true.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "no-longer-human-zh-p00194",
      "unit_index": 9,
      "source_text": "我真的喝了，才不是故意裝醉呢。」",
      "en": [
        {
          "t": "I really did drink; I'm not pretending to be drunk.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "no-longer-human-zh-p00194",
      "unit_index": 10,
      "source_text": "「你別逗我玩了。",
      "en": [
        {
          "t": "Stop teasing me.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "no-longer-human-zh-p00194",
      "unit_index": 11,
      "source_text": "你好壞呀。」",
      "en": [
        {
          "t": "You're so mean.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "no-longer-human-zh-p00194",
      "unit_index": 12,
      "source_text": "她一點都不懷疑我。",
      "en": [
        {
          "t": "She did not doubt me at all.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "no-longer-human-zh-p00194",
      "unit_index": 13,
      "source_text": "「你看我一下不就明白了嗎？",
      "en": [
        {
          "t": "You would understand if you just looked at me, wouldn't you?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "no-longer-human-zh-p00194",
      "unit_index": 14,
      "source_text": "我今天又是從中午開喝的。",
      "en": [
        {
          "t": "Today I started drinking again at noon.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "no-longer-human-zh-p00194",
      "unit_index": 15,
      "source_text": "請原諒啊。」",
      "en": [
        {
          "t": "Please forgive me.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "no-longer-human-zh-p00194",
      "unit_index": 16,
      "source_text": "「你可真會演戲呢。」",
      "en": [
        {
          "t": "You really are good at acting.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "no-longer-human-zh-p00194",
      "unit_index": 17,
      "source_text": "「不是演戲啦，傻丫頭，當心我親你喲。」",
      "en": [
        {
          "t": "I'm not acting, silly girl. Watch out, I might kiss you.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "no-longer-human-zh-p00194",
      "unit_index": 18,
      "source_text": "「來親呀。」",
      "en": [
        {
          "t": "Go ahead and kiss me.",
          "g": "predicate"
        }
      ]
    }
  ]
}
