{
  "schema_version": 1,
  "task_family": "incremental_english_modern_japanese_overlay",
  "book_id": "no-longer-human",
  "chunk_id": "no-longer-human-chunk-0217",
  "units": [
    {
      "paragraph_id": "no-longer-human-zh-p00217",
      "unit_index": 1,
      "source_text": "「我反正什麼都沒做……」",
      "en": [
        {
          "t": "I have not done anything anyway...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "no-longer-human-zh-p00217",
      "unit_index": 2,
      "source_text": "「行啦行啦，什麼都別說了。",
      "en": [
        {
          "t": "All right, all right, do not say anything more.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "no-longer-human-zh-p00217",
      "unit_index": 3,
      "source_text": "你是不懂得懷疑人的人。",
      "en": [
        {
          "t": "You are someone who does not know how to doubt people.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "no-longer-human-zh-p00217",
      "unit_index": 4,
      "source_text": "坐坐坐，一起吃蠶豆吧。」",
      "en": [
        {
          "t": "Sit down, sit down, let us eat some broad beans together.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "no-longer-human-zh-p00217",
      "unit_index": 5,
      "source_text": "我們並肩坐下，吃著蠶豆。",
      "en": [
        {
          "t": "We sat down side by side and ate the broad beans.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "no-longer-human-zh-p00217",
      "unit_index": 6,
      "source_text": "嗚呼，信賴也是罪過嗎？",
      "en": [
        {
          "t": "Ah, is trust also a sin?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "no-longer-human-zh-p00217",
      "unit_index": 7,
      "source_text": "那個男人三十上下，是一個不學無術的矮個頭商人，常常來找我畫漫畫，每次都會裝模作樣地留下一些錢，然後才離去。",
      "en": [
        {
          "t": "That man was a short, uneducated merchant of about thirty, who often came to have me draw comics for him, and each time he would ostentatiously leave a little money before going away.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "no-longer-human-zh-p00217",
      "unit_index": 8,
      "source_text": "後來那個商人就再也沒有來過。",
      "en": [
        {
          "t": "After that, the merchant never came again.",
          "g": "predicate"
        }
      ]
    }
  ]
}
