    {
      "paragraph_id": "woman-in-the-dunes-p00502",
      "unit_index": 1,
      "source_text": "“不是那么回事。",
      "en": [
        {
          "t": "That is not how it is.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00502",
      "unit_index": 2,
      "source_text": "自己本身变成沙子……",
      "en": [
        {
          "t": "You become sand yourself...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00502",
      "unit_index": 3,
      "source_text": "用沙子的眼睛来看东西……",
      "en": [
        {
          "t": "You see things through the eyes of sand...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00502",
      "unit_index": 4,
      "source_text": "如果死了一次，就会担心死……",
      "en": [
        {
          "t": "If you have died once, you become afraid of dying...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00502",
      "unit_index": 5,
      "source_text": "就再也不会横冲直撞了……”",
      "en": [
        {
          "t": "and you will never rush ahead recklessly again...\"",
          "g": "predicate"
        }
      ]
    }
  ]
