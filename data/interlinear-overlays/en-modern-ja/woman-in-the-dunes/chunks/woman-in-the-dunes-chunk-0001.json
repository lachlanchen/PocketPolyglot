  "units": [
    {
      "paragraph_id": "woman-in-the-dunes-p00001",
      "unit_index": 1,
      "source_text": "八月里的一天，一个男人失踪了。",
      "en": [
        {
          "t": "One day in August, a man disappeared.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00001",
      "unit_index": 2,
      "source_text": "他利用休假去海边，",
      "en": [
        {
          "t": "He used his vacation to go to the seaside,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00001",
      "unit_index": 3,
      "source_text": "听说那地方坐半天火车即可到达，",
      "en": [
        {
          "t": "having heard that the place could be reached by a half-day train ride,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00001",
      "unit_index": 4,
      "source_text": "谁知他一去便杳无音信。",
      "en": [
        {
          "t": "but once he went, he vanished without a trace.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00001",
      "unit_index": 5,
      "source_text": "家属向警察局报案，",
      "en": [
        {
          "t": "His family reported it to the police,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00001",
      "unit_index": 6,
      "source_text": "在报纸上登寻人启事，",
      "en": [
        {
          "t": "and placed a missing-person notice in the newspaper,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00001",
      "unit_index": 7,
      "source_text": "结果都如石沉大海。",
      "en": [
        {
          "t": "but every effort sank without a response, like a stone dropped into the sea.",
          "g": "predicate"
        }
      ]
    }
  ]
}
