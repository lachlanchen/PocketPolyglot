{
  "schema_version": 1,
  "task_family": "incremental_english_modern_japanese_overlay",
  "book_id": "woman-in-the-dunes",
  "chunk_id": "woman-in-the-dunes-chunk-0873",
  "units": [
    {
      "paragraph_id": "woman-in-the-dunes-p00873",
      "unit_index": 1,
      "source_text": "走吧，快！",
      "en": [
        {
          "t": "Go on, hurry!",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00873",
      "unit_index": 2,
      "source_text": "……嗯，沉下腰，往低处奔跑！",
      "en": [
        {
          "t": "...Yes, lower your body and run toward the low ground!",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00873",
      "unit_index": 3,
      "source_text": "……并没有让人慌慌张张的事……",
      "en": [
        {
          "t": "...There is nothing here to panic over...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00873",
      "unit_index": 4,
      "source_text": "谨慎点儿，充分留神周围，赶快……",
      "en": [
        {
          "t": "Be careful, keep a close watch all around, and hurry...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00873",
      "unit_index": 5,
      "source_text": "快，在这个坑里趴下来！",
      "en": [
        {
          "t": "Quick, lie down in this hollow!",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00873",
      "unit_index": 6,
      "source_text": "……没发出可疑的声音吧？",
      "en": [
        {
          "t": "...You did not make any suspicious noise, did you?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00873",
      "unit_index": 7,
      "source_text": "……没有不祥的预感吧？",
      "en": [
        {
          "t": "...You do not have any ominous feeling, do you?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00873",
      "unit_index": 8,
      "source_text": "……没有的话，赶快站起来再往前走……",
      "en": [
        {
          "t": "...If not, get up quickly and keep moving forward...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00873",
      "unit_index": 9,
      "source_text": "太靠右了不行！",
      "en": [
        {
          "t": "Do not go too far to the right!",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00873",
      "unit_index": 10,
      "source_text": "……右面的坝太低了，恐怕会被坝里的人看见……",
      "en": [
        {
          "t": "...The embankment on the right is too low; someone inside it might see you...",
          "g": "predicate"
        }
      ]
    }
  ]
}
