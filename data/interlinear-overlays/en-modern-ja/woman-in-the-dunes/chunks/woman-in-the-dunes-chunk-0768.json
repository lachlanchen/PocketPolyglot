  "units": [
    {
      "paragraph_id": "woman-in-the-dunes-p00768",
      "unit_index": 1,
      "source_text": "忽然，响起了女人的声音。",
      "en": [
        {
          "t": "Suddenly, the woman's voice rang out.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00768",
      "unit_index": 2,
      "source_text": "她正面对坝那边高叫着打招呼呢！",
      "en": [
        {
          "t": "She was facing the other side of the embankment and calling out a greeting!",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00768",
      "unit_index": 3,
      "source_text": "透过沉重的眼皮，他吃力地张望着。",
      "en": [
        {
          "t": "Through his heavy eyelids, he strained to look around.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00768",
      "unit_index": 4,
      "source_text": "最早领他上这儿来的那个老头，正往绳头上挂铅桶准备吊下来。",
      "en": [
        {
          "t": "The old man who had first brought him here was fastening a metal bucket to the end of the rope, getting ready to lower it down.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00768",
      "unit_index": 5,
      "source_text": "是水！……",
      "en": [
        {
          "t": "It was water! ...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00768",
      "unit_index": 6,
      "source_text": "总算来了！……",
      "en": [
        {
          "t": "At last it had come! ...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00768",
      "unit_index": 7,
      "source_text": "铅桶斜斜的，在沙的斜坡上划出了一道道痕迹。",
      "en": [
        {
          "t": "The bucket hung at an angle, cutting line after line into the sandy slope.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00768",
      "unit_index": 8,
      "source_text": "不折不扣的水哇！……",
      "en": [
        {
          "t": "Real water, no mistake! ...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00768",
      "unit_index": 9,
      "source_text": "男人叫喊着，跌跌撞撞地跑了过去。",
      "en": [
        {
          "t": "The man shouted and stumbled as he ran toward it.",
          "g": "predicate"
        }
      ]
    }
  ]
}
