{
  "schema_version": 1,
  "task_family": "incremental_english_modern_japanese_overlay",
  "book_id": "woman-in-the-dunes",
  "chunk_id": "woman-in-the-dunes-chunk-0530",
  "units": [
    {
      "paragraph_id": "woman-in-the-dunes-p00530",
      "unit_index": 1,
      "source_text": "可他还是缩回了手。",
      "en": [
        {
          "t": "But he still drew his hand back.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00530",
      "unit_index": 2,
      "source_text": "慌慌张张吹熄了灯。",
      "en": [
        {
          "t": "In a panic, he blew out the lamp.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00530",
      "unit_index": 3,
      "source_text": "大网篮的声音靠近了。",
      "en": [
        {
          "t": "The sound of the large net basket came closer.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00530",
      "unit_index": 4,
      "source_text": "他把灭了的灯，放在顺手摸得着的台阶边上，掏出水槽下的壶，喝了好大一口。",
      "en": [
        {
          "t": "He set the extinguished lamp beside the step where he could easily feel for it, pulled out the jug from under the water tank, and took a long drink.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00530",
      "unit_index": 5,
      "source_text": "抄起铁锹，藏在门口一边。",
      "en": [
        {
          "t": "He snatched up the shovel and hid to one side of the doorway.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00530",
      "unit_index": 6,
      "source_text": "汗流浃背。",
      "en": [
        {
          "t": "Sweat was pouring down his back.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00530",
      "unit_index": 7,
      "source_text": "马上就要开战了……",
      "en": [
        {
          "t": "The fight was about to begin...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00530",
      "unit_index": 8,
      "source_text": "再坚持五分钟，十分钟……",
      "en": [
        {
          "t": "If he could hold out another five minutes, ten minutes...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00530",
      "unit_index": 9,
      "source_text": "他把采集箱紧紧地拉到身边来。",
      "en": [
        {
          "t": "He pulled the collecting box tightly in beside him.",
          "g": "predicate"
        }
      ]
    }
  ]
}
