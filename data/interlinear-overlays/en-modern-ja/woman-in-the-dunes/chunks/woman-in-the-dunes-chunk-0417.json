  "units": [
    {
      "paragraph_id": "woman-in-the-dunes-p00417",
      "unit_index": 1,
      "source_text": "“岂有此理！",
      "en": [
        {
          "t": "This is outrageous!",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00417",
      "unit_index": 2,
      "source_text": "让生手不当心扭坏了，那还了得？",
      "en": [
        {
          "t": "If you let an amateur twist it wrong and damage it, what then?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00417",
      "unit_index": 3,
      "source_text": "背脊骨的神经可是命根子哟。",
      "en": [
        {
          "t": "The nerves in the spine are the very root of life, you know.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00417",
      "unit_index": 4,
      "source_text": "我死了，看你们还有什么打算！",
      "en": [
        {
          "t": "If I die, let us see what plans you have left!",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00417",
      "unit_index": 5,
      "source_text": "该你们发愁了吧？",
      "en": [
        {
          "t": "Then it will be your turn to worry, will it not?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00417",
      "unit_index": 6,
      "source_text": "去叫医生，叫医生！",
      "en": [
        {
          "t": "Go call a doctor, call a doctor!",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00417",
      "unit_index": 7,
      "source_text": "疼死喽……疼死喽……",
      "en": [
        {
          "t": "The pain is killing me... killing me...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00417",
      "unit_index": 8,
      "source_text": "不快点去叫可就来不及了！”",
      "en": [
        {
          "t": "If you do not hurry and call one, it will be too late!\"",
          "g": "predicate"
        }
      ]
    }
  ]
}
