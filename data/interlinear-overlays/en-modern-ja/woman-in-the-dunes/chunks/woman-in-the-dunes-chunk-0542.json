  "units": [
    {
      "paragraph_id": "woman-in-the-dunes-p00542",
      "unit_index": 1,
      "source_text": "上面像在交换意见。",
      "en": [
        {
          "t": "Up above, they seemed to be exchanging opinions.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00542",
      "unit_index": 2,
      "source_text": "忽地，手上传来强烈的反应，绳索开始往上提起来。",
      "en": [
        {
          "t": "Suddenly, a strong response came through his hands, and the rope began to be pulled upward.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00542",
      "unit_index": 3,
      "source_text": "比预想的更富有弹性的重量，从手指上拔去绳索。",
      "en": [
        {
          "t": "A weight more springy than he had expected tugged the rope out from his fingers.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00542",
      "unit_index": 4,
      "source_text": "男人用了两倍以上的力气，牢牢地抓紧……",
      "en": [
        {
          "t": "The man gripped it firmly with more than twice the strength...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00542",
      "unit_index": 5,
      "source_text": "像大笑时那样，胃的周围激烈地痉挛起来，涌起泡沫喷了上来……",
      "en": [
        {
          "t": "As if he were laughing aloud, the area around his stomach convulsed violently, and foam welled up and burst out...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00542",
      "unit_index": 6,
      "source_text": "一星期的噩梦，四分五裂飞散而去……",
      "en": [
        {
          "t": "A week of nightmares shattered and scattered away...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00542",
      "unit_index": 7,
      "source_text": "太好了……",
      "en": [
        {
          "t": "Thank goodness...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00542",
      "unit_index": 8,
      "source_text": "太好了……",
      "en": [
        {
          "t": "Thank goodness...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00542",
      "unit_index": 9,
      "source_text": "这下可得救了！",
      "en": [
        {
          "t": "Now he would be saved!",
          "g": "predicate"
        }
      ]
    }
  ]
}
