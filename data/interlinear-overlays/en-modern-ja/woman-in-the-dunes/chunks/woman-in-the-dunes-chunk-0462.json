    {
      "paragraph_id": "woman-in-the-dunes-p00462",
      "unit_index": 4,
      "source_text": "直到来这儿之前……",
      "en": [
        {
          "t": "Right up until before I came here...",
          "g": "predicate"
        }
      ]
