  "units": [
    {
      "paragraph_id": "woman-in-the-dunes-p00765",
      "unit_index": 1,
      "source_text": "冷不防落下了冰凉而湿漉漉的手帕般的影子。",
      "en": [
        {
          "t": "All at once, a cold, damp, handkerchief-like shadow fell over him.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00765",
      "unit_index": 2,
      "source_text": "云彩出现了。",
      "en": [
        {
          "t": "Clouds had appeared.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00765",
      "unit_index": 3,
      "source_text": "落叶般的云被风刮到天空的一角。",
      "en": [
        {
          "t": "Leaf-like clouds were blown by the wind into one corner of the sky.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00765",
      "unit_index": 4,
      "source_text": "妈的，至少下几滴雨，也就不会碰到这种倒霉事了……",
      "en": [
        {
          "t": "Damn it, if only a few drops of rain had fallen, he would not have run into this kind of rotten luck...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00765",
      "unit_index": 5,
      "source_text": "摊开手掌，两手满是雨水……",
      "en": [
        {
          "t": "He spread open his palms, and both hands were full of rainwater...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00765",
      "unit_index": 6,
      "source_text": "窗玻璃上净是小瀑布……",
      "en": [
        {
          "t": "The window glass was covered with little waterfalls...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00765",
      "unit_index": 7,
      "source_text": "落水管里喷出水柱……",
      "en": [
        {
          "t": "Columns of water were spurting from the drainpipes...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00765",
      "unit_index": 8,
      "source_text": "倾泻在柏油马路上的瓢泼大雨……",
      "en": [
        {
          "t": "A torrential rain poured down onto the asphalt road...",
          "g": "predicate"
        }
      ]
    }
  ]
}
