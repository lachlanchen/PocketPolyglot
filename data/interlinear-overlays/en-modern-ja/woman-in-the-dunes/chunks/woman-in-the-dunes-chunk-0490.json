  "units": [
    {
      "paragraph_id": "woman-in-the-dunes-p00490",
      "unit_index": 1,
      "source_text": "是呵……要是没有那封信……",
      "en": [
        {
          "t": "Yes... if only there had been no letter...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00490",
      "unit_index": 2,
      "source_text": "要是没有那封傻乎乎的信……",
      "en": [
        {
          "t": "If only there had been no such foolish letter...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00490",
      "unit_index": 3,
      "source_text": "可是，有就是有了……",
      "en": [
        {
          "t": "But it had existed, and that was that...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00490",
      "unit_index": 4,
      "source_text": "就连做梦也告知了那般真实，到现在还来自己哄骗自己，又成得了什么气候呢？",
      "en": [
        {
          "t": "Even the dream had revealed the truth so clearly; what good would it do to keep deceiving himself now?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00490",
      "unit_index": 5,
      "source_text": "推脱之辞已经太多。",
      "en": [
        {
          "t": "There had already been too many excuses.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00490",
      "unit_index": 6,
      "source_text": "遗留品等等都已经死了。",
      "en": [
        {
          "t": "The relics and everything like them were already dead.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00490",
      "unit_index": 7,
      "source_text": "他用自己的手，扼杀了生命。",
      "en": [
        {
          "t": "With his own hands, he had strangled life itself.",
          "g": "predicate"
        }
      ]
    }
  ]
}
