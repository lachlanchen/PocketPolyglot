  "units": [
    {
      "paragraph_id": "woman-in-the-dunes-p00747",
      "unit_index": 1,
      "source_text": "他醒过来。",
      "en": [
        {
          "t": "He woke up.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00747",
      "unit_index": 2,
      "source_text": "黏乎乎的舌根成了融化了的热骨胶。",
      "en": [
        {
          "t": "The sticky root of his tongue had become melted, hot animal glue.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00747",
      "unit_index": 3,
      "source_text": "干渴翻了一倍又回来了……",
      "en": [
        {
          "t": "His thirst doubled and came back again...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00747",
      "unit_index": 4,
      "source_text": "想喝水！",
      "en": [
        {
          "t": "He wanted water!",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00747",
      "unit_index": 5,
      "source_text": "……闪闪发亮的水晶之水……",
      "en": [
        {
          "t": "...sparkling crystal water...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00747",
      "unit_index": 6,
      "source_text": "从茶杯底部泛起泡沫的银色轨迹……",
      "en": [
        {
          "t": "The silver trails of bubbles rising from the bottom of a teacup...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "woman-in-the-dunes-p00747",
      "unit_index": 7,
      "source_text": "废弃屋子的自来水管，像鱼儿似的喘着气，沾满灰尘，净是蜘蛛……",
      "en": [
        {
          "t": "The water pipe in an abandoned house, gasping like a fish, covered in dust and crawling with spiders...",
          "g": "predicate"
        }
      ]
    }
  ]
}
