  "units": [
    {
      "paragraph_id": "kinkakuji-p01419",
      "unit_index": 1,
      "source_text": "我抱起这三捆稻草，从菜园旁边返回去了。",
      "en": [
        {
          "t": "I picked up the three bundles of straw and went back from beside the vegetable garden.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01419",
      "unit_index": 2,
      "source_text": "厨房寂然无声。",
      "en": [
        {
          "t": "The kitchen was utterly silent.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01419",
      "unit_index": 3,
      "source_text": "我从厨房的拐角绕到了执事的宿舍后面，这时厕所的窗扉突然透射出了亮光。",
      "en": [
        {
          "t": "I went around the corner of the kitchen to the back of the steward's quarters, and just then light suddenly shone out through the toilet window.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01419",
      "unit_index": 4,
      "source_text": "我就地蹲了下来。",
      "en": [
        {
          "t": "I crouched down on the spot.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01419",
      "unit_index": 5,
      "source_text": "片刻，传来了一阵撒尿声。",
      "en": [
        {
          "t": "After a moment, the sound of someone urinating came to me.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01419",
      "unit_index": 6,
      "source_text": "这声音是无限的长。",
      "en": [
        {
          "t": "The sound went on endlessly.",
          "g": "predicate"
        }
      ]
    }
  ]
