{
  "schema_version": 1,
  "task_family": "incremental_english_modern_japanese_overlay",
  "book_id": "kinkakuji",
  "chunk_id": "kinkakuji-chunk-0585",
  "units": [
    {
      "paragraph_id": "kinkakuji-p00585",
      "unit_index": 1,
      "source_text": "柏术使我清楚地了解我的羞耻之所在，",
      "en": [
        {
          "t": "Kashiwagi made me clearly understand where my shame lay,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00585",
      "unit_index": 2,
      "source_text": "同时也促使我走向人生……",
      "en": [
        {
          "t": "and at the same time he also urged me toward life...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00585",
      "unit_index": 3,
      "source_text": "我所有的潜在的感情，",
      "en": [
        {
          "t": "All of my latent feelings,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00585",
      "unit_index": 4,
      "source_text": "所有邪恶的心理，",
      "en": [
        {
          "t": "all of my evil states of mind,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00585",
      "unit_index": 5,
      "source_text": "都受到他的语言的陶冶，",
      "en": [
        {
          "t": "were all cultivated by his words,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00585",
      "unit_index": 6,
      "source_text": "变成一种新鲜的东西。",
      "en": [
        {
          "t": "and changed into something fresh and new.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00585",
      "unit_index": 7,
      "source_text": "也许由于这个缘故，",
      "en": [
        {
          "t": "Perhaps for that reason,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00585",
      "unit_index": 8,
      "source_text": "我们踏着碎石路，",
      "en": [
        {
          "t": "we walked along the gravel path,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00585",
      "unit_index": 9,
      "source_text": "走出了用红砖砌的正门，",
      "en": [
        {
          "t": "passed out through the main gate built of red brick,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00585",
      "unit_index": 10,
      "source_text": "迎面看到的比睿山承受着春日的滋润，",
      "en": [
        {
          "t": "and Mount Hiei before us seemed to receive the moist richness of the spring day,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00585",
      "unit_index": 11,
      "source_text": "仿佛是今天才第一次看到似的。",
      "en": [
        {
          "t": "as if we were seeing it for the very first time today.",
          "g": "predicate"
        }
      ]
    }
  ]
}
