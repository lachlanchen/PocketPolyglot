  "units": [
    {
      "paragraph_id": "kinkakuji-p01465",
      "unit_index": 1,
      "source_text": "我的心欢快地跳动，濡湿了的手微微颤抖着。",
      "en": [
        {
          "t": "My heart beat joyfully, and my wet hands trembled slightly.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01465",
      "unit_index": 2,
      "source_text": "火柴也潮湿了。",
      "en": [
        {
          "t": "The matches were damp too.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01465",
      "unit_index": 3,
      "source_text": "头一根没有划着。",
      "en": [
        {
          "t": "The first one would not light.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01465",
      "unit_index": 4,
      "source_text": "第二根刚划着又折以了。",
      "en": [
        {
          "t": "The second one lit for an instant, then snapped again.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01465",
      "unit_index": 5,
      "source_text": "划第三根时，我用手挡风，火光从指缝透了出来，燃着了。",
      "en": [
        {
          "t": "When I struck the third match, I shielded it from the wind with my hand; the flame shone through my fingers and caught.",
          "g": "predicate"
        }
      ]
    }
  ]
}
