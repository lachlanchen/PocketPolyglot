  "units": [
    {
      "paragraph_id": "kinkakuji-p01017",
      "unit_index": 1,
      "source_text": "我坐在窄席上等候。",
      "en": [
        {
          "t": "I sat waiting on the narrow seat.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01017",
      "unit_index": 2,
      "source_text": "就在等候的时间里，我感到自己的命运将由那女人濡湿、皲裂的手来决定，",
      "en": [
        {
          "t": "As I waited, I felt that my fate would be decided by that woman's damp, chapped hands,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01017",
      "unit_index": 3,
      "source_text": "这实在是太没有意义了。",
      "en": [
        {
          "t": "and that seemed utterly meaningless.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01017",
      "unit_index": 4,
      "source_text": "可是，自己就是为了这份无意义的赌注才来的，",
      "en": [
        {
          "t": "Yet I had come precisely for this meaningless wager,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01017",
      "unit_index": 5,
      "source_text": "因而也就算了。",
      "en": [
        {
          "t": "so I let it be.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01017",
      "unit_index": 6,
      "source_text": "关闭的拉门里传来了相当难开的小抽屉的古老金属环的撞击声，",
      "en": [
        {
          "t": "From behind the closed sliding door came the clatter of an old metal ring on a small drawer that seemed rather hard to open,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01017",
      "unit_index": 7,
      "source_text": "还有掀纸页声。",
      "en": [
        {
          "t": "and also the sound of pages being turned.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01017",
      "unit_index": 8,
      "source_text": "良久，拉门打开了一条小维。",
      "en": [
        {
          "t": "After a long while, the sliding door opened a narrow crack.",
          "g": "predicate"
        }
      ]
    }
  ]
}
