      "paragraph_id": "kinkakuji-p00680",
      "unit_index": 1,
      "source_text": "\"痛啊！痛啊！\"",
      "en": [
        {
          "t": "\"It hurts! It hurts!\"",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00680",
      "unit_index": 2,
      "source_text": "柏木突然弯腰按着小腿呻吟起来。",
      "en": [
        {
          "t": "Kashiwagi suddenly bent over, clutching his shin, and began to groan.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00680",
      "unit_index": 3,
      "source_text": "我慌忙蹲下来照料他，他却用手把我推开，给了我一个不可思议的冷笑的暗示。",
      "en": [
        {
          "t": "I hurriedly crouched down to tend to him, but he pushed me away with his hand and gave me an inexplicable hint of a sneer.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00680",
      "unit_index": 4,
      "source_text": "我把手抽了回来。",
      "en": [
        {
          "t": "I drew my hand back.",
          "g": "predicate"
        }
      ]
    }
  ]
