  "units": [
    {
      "paragraph_id": "kinkakuji-p00515",
      "unit_index": 1,
      "source_text": "顿时大家获得了解放，熙熙攘攘地跑进了正门里。",
      "en": [
        {
          "t": "All at once everyone felt released, and they streamed noisily in through the main gate.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00515",
      "unit_index": 2,
      "source_text": "我正在发呆，离川拍了拍我的肩膀。",
      "en": [
        {
          "t": "I was standing there in a daze when Rikawa patted me on the shoulder.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00515",
      "unit_index": 3,
      "source_text": "我的肩膀苏醒了。",
      "en": [
        {
          "t": "My shoulder woke up.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00515",
      "unit_index": 4,
      "source_text": "这瘦骨嶙峋的丑陋的肩膀又恢复了自豪。",
      "en": [
        {
          "t": "That bony, ugly shoulder regained its pride.",
          "g": "predicate"
        }
      ]
    }
  ]
