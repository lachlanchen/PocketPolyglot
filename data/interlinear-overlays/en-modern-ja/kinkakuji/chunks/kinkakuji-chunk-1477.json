  "units": [
    {
      "paragraph_id": "kinkakuji-p01477",
      "unit_index": 1,
      "source_text": "潮音洞已经弥漫烟雾。",
      "en": [
        {
          "t": "Smoke had already filled the Choon Cave.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01477",
      "unit_index": 2,
      "source_text": "脚底下响起了火烧的爆裂声。",
      "en": [
        {
          "t": "Beneath my feet came the crackling sounds of fire burning.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01477",
      "unit_index": 3,
      "source_text": "我被烟呛得几乎窒息了。",
      "en": [
        {
          "t": "I was choking on the smoke and almost suffocated.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01477",
      "unit_index": 4,
      "source_text": "我一边不停地咳嗽，一边还在叩门。",
      "en": [
        {
          "t": "I kept coughing without stop, yet I was still knocking on the door.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01477",
      "unit_index": 5,
      "source_text": "门扉还是不开。",
      "en": [
        {
          "t": "The door still would not open.",
          "g": "predicate"
        }
      ]
    }
  ]
}
