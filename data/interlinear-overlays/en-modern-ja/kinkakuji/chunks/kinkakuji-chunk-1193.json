  "units": [
    {
      "paragraph_id": "kinkakuji-p01193",
      "unit_index": 1,
      "source_text": "\"寺庙就无法再困你了！\"",
      "en": [
        {
          "t": "The temple will no longer be able to keep you trapped!",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01193",
      "unit_index": 2,
      "source_text": "老师说。",
      "en": [
        {
          "t": "The teacher said.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01193",
      "unit_index": 3,
      "source_text": "我第一次从老师的嘴里听到这句话。",
      "en": [
        {
          "t": "It was the first time I had heard those words from the teacher's own mouth.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01193",
      "unit_index": 4,
      "source_text": "可以说我得到老师的许诺了。",
      "en": [
        {
          "t": "You could say that I had obtained the teacher's promise.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01193",
      "unit_index": 5,
      "source_text": "突然间，事态变得明朗了。",
      "en": [
        {
          "t": "All at once, the situation became clear.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01193",
      "unit_index": 6,
      "source_text": "老师早就有了驱逐我的念头。",
      "en": [
        {
          "t": "The teacher had long since had the idea of expelling me.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01193",
      "unit_index": 7,
      "source_text": "我必须果断从速行事。",
      "en": [
        {
          "t": "I had to act decisively and without delay.",
          "g": "predicate"
        }
      ]
    }
  ]
}
