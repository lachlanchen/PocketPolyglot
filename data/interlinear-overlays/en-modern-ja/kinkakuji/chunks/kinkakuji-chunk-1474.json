  "units": [
    {
      "paragraph_id": "kinkakuji-p01474",
      "unit_index": 1,
      "source_text": "我叩这扇门。",
      "en": [
        {
          "t": "I knocked on this door.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01474",
      "unit_index": 2,
      "source_text": "叩门声相当激烈，却没有落入我的耳朵里。",
      "en": [
        {
          "t": "The knocking was quite violent, yet the sound did not reach my ears.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01474",
      "unit_index": 3,
      "source_text": "我拼命地叩。",
      "en": [
        {
          "t": "I knocked desperately.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01474",
      "unit_index": 4,
      "source_text": "因为我觉得会有人从究竟顶内侧给我开门的。",
      "en": [
        {
          "t": "Because I felt that someone would open the door for me from inside the Kukyocho.",
          "g": "predicate"
        }
      ]
    }
  ]
