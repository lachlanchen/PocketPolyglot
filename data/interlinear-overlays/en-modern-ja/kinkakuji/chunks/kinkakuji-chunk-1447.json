  "units": [
    {
      "paragraph_id": "kinkakuji-p01447",
      "unit_index": 1,
      "source_text": "\"我已准备只差一步就行动了。\"",
      "en": [
        {
          "t": "\"I had prepared myself to the point where only one step remained before action.\"",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01447",
      "unit_index": 2,
      "source_text": "我前南自语，",
      "en": [
        {
          "t": "I muttered to myself,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01447",
      "unit_index": 3,
      "source_text": "\"既然行动本身完全是梦幻，既然我已经完全发挥了这个梦幻的作用，",
      "en": [
        {
          "t": "\"Since action itself is entirely an illusion, and since I have already fully fulfilled the role of that illusion,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01447",
      "unit_index": 4,
      "source_text": "那么还有必要行动吗？",
      "en": [
        {
          "t": "is there still any need to act?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01447",
      "unit_index": 5,
      "source_text": "这不是徒劳无益的事吗？\"",
      "en": [
        {
          "t": "Would that not be a futile and useless thing?\"",
          "g": "predicate"
        }
      ]
    }
  ]
}
