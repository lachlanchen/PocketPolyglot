  "units": [
    {
      "paragraph_id": "kinkakuji-p01455",
      "unit_index": 1,
      "source_text": "我的身体麻木了。",
      "en": [
        {
          "t": "My body had gone numb.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01455",
      "unit_index": 2,
      "source_text": "泪珠子一串串地涌流了出来。",
      "en": [
        {
          "t": "Tears welled up and streamed out in strings.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01455",
      "unit_index": 3,
      "source_text": "就这样持续到天明，即使被人发现也无所谓了。",
      "en": [
        {
          "t": "If things went on like this until dawn, it no longer mattered even if someone found me.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01455",
      "unit_index": 4,
      "source_text": "我大概不会做任何的辩解。",
      "en": [
        {
          "t": "I probably would not make any excuse at all.",
          "g": "predicate"
        }
      ]
    }
  ]
}
