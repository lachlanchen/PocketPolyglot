  "units": [
    {
      "paragraph_id": "kinkakuji-p00850",
      "unit_index": 1,
      "source_text": "\"已经济不出奶汁了。",
      "en": [
        {
          "t": "\"No milk comes out anymore, even when it is squeezed.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00850",
      "unit_index": 2,
      "source_text": "啊，可怜的婴儿！",
      "en": [
        {
          "t": "Ah, poor baby!",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00850",
      "unit_index": 3,
      "source_text": "就是挤不出奶汁，我也要照样让你看嘛。",
      "en": [
        {
          "t": "Even if no milk comes out, I still want to let you see me just the same.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00850",
      "unit_index": 4,
      "source_text": "因为从那时候起你就喜欢我，如今我是把你当做当年的他呀！",
      "en": [
        {
          "t": "Because you have liked me ever since then, and now I am treating you as if you were him back then!",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00850",
      "unit_index": 5,
      "source_text": "一想起他，我就不觉得羞耻了。",
      "en": [
        {
          "t": "When I think of him, I no longer feel ashamed.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00850",
      "unit_index": 6,
      "source_text": "真的，我就像当年的样子让你看呀！\"",
      "en": [
        {
          "t": "Really, I am letting you see me just as I was back then!\"",
          "g": "predicate"
        }
      ]
    }
  ]
}
