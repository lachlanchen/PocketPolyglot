  "units": [
    {
      "paragraph_id": "kinkakuji-p00612",
      "unit_index": 1,
      "source_text": "柏木颓然地摔倒在女子步行的紧前方。",
      "en": [
        {
          "t": "Kashiwagi collapsed limply right in front of the woman as she was walking.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00612",
      "unit_index": 2,
      "source_text": "女子顿时呆立不动。",
      "en": [
        {
          "t": "The woman instantly stood frozen in place.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00612",
      "unit_index": 3,
      "source_text": "我想把柏木搀扶起来，",
      "en": [
        {
          "t": "I tried to help Kashiwagi up,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00612",
      "unit_index": 4,
      "source_text": "好不容易蹲了下来，",
      "en": [
        {
          "t": "and at last managed to crouch down,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00612",
      "unit_index": 5,
      "source_text": "霎时间我从她那冷漠的高鼻子、那带有几分轻优的嘴角、那水灵的眼睛等所有这一切，",
      "en": [
        {
          "t": "and in that instant, from everything about her, her cold high nose, the faintly melancholy corners of her mouth, her limpid eyes,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00612",
      "unit_index": 6,
      "source_text": "看到了月光下的有为子的面影。",
      "en": [
        {
          "t": "I saw the image of Uiko in the moonlight.",
          "g": "predicate"
        }
      ]
    }
  ]
}
