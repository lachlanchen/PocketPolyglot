  "units": [
    {
      "paragraph_id": "kinkakuji-p00498",
      "unit_index": 1,
      "source_text": "此后一年，我成为被逮住的笼中鸟。",
      "en": [
        {
          "t": "For the following year, I became a caged bird that had been caught.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00498",
      "unit_index": 2,
      "source_text": "笼子不断地映入我的眼帘。",
      "en": [
        {
          "t": "The cage kept coming into my sight.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00498",
      "unit_index": 3,
      "source_text": "我打定主意决不忏悔。",
      "en": [
        {
          "t": "I firmly resolved that I would never repent.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00498",
      "unit_index": 4,
      "source_text": "可是，我每天都不得平静。",
      "en": [
        {
          "t": "And yet, not a day passed in which I could be at peace.",
          "g": "predicate"
        }
      ]
    }
  ]
}
