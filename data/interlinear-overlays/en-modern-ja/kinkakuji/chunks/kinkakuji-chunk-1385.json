  "units": [
    {
      "paragraph_id": "kinkakuji-p01385",
      "unit_index": 1,
      "source_text": "这一天到来了。",
      "en": [
        {
          "t": "That day had come.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01385",
      "unit_index": 2,
      "source_text": "那是1950年7月三日。",
      "en": [
        {
          "t": "It was July 3, 1950.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01385",
      "unit_index": 3,
      "source_text": "正如前述，估计今天之内不会修理好火警报警器。",
      "en": [
        {
          "t": "As I said before, it seemed unlikely that the fire alarm would be repaired by the end of the day.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01385",
      "unit_index": 4,
      "source_text": "下午六点，这已经成为事实。",
      "en": [
        {
          "t": "By six o'clock in the evening, this had already become a fact.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01385",
      "unit_index": 5,
      "source_text": "因为向导老人再次挂电话催促过了。",
      "en": [
        {
          "t": "For the old guide had telephoned again to urge them on.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01385",
      "unit_index": 6,
      "source_text": "工人回答说：\"对不起，今天太忙，去不了。",
      "en": [
        {
          "t": "The workman replied, \"I'm sorry, but I am too busy today and cannot come.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p01385",
      "unit_index": 7,
      "source_text": "明儿一定去。",
      "en": [
        {
          "t": "I will definitely come tomorrow.",
          "g": "predicate"
        }
      ]
    }
  ]
}
