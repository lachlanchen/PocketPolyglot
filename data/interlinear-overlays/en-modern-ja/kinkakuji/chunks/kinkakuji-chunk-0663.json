  "book_id": "kinkakuji",
  "chunk_id": "kinkakuji-chunk-0663",
  "units": [
    {
      "paragraph_id": "kinkakuji-p00663",
      "unit_index": 1,
      "source_text": "\"那与佛教有什么相干呢。",
      "en": [
        {
          "t": "What does that have to do with Buddhism?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00663",
      "unit_index": 2,
      "source_text": "优雅。",
      "en": [
        {
          "t": "Elegance.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00663",
      "unit_index": 3,
      "source_text": "文化，人所想像的美的东西，所有这一切的实像，都是无结果的无机的东西。",
      "en": [
        {
          "t": "Culture, the beautiful things people imagine, the true form of all these things, are inorganic things that lead to no result.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00663",
      "unit_index": 4,
      "source_text": "不是龙安寺，只是石头而且。",
      "en": [
        {
          "t": "It is not Ryoanji, but merely stones.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00663",
      "unit_index": 5,
      "source_text": "哲学，这也是石头。",
      "en": [
        {
          "t": "Philosophy, that too is stone.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00663",
      "unit_index": 6,
      "source_text": "艺术，这也是石头。",
      "en": [
        {
          "t": "Art, that too is stone.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00663",
      "unit_index": 7,
      "source_text": "至于谈到人的有机的关心，不是挺可悲的吗，因为只有政治啊！",
      "en": [
        {
          "t": "As for the organic concerns of human beings, is it not quite sad, since there is only politics!",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00663",
      "unit_index": 8,
      "source_text": "人实在是自我冒渎的生物啊！\"",
      "en": [
        {
          "t": "Human beings truly are creatures that profane themselves!\"",
          "g": "predicate"
        }
      ]
    }
  ]
}
