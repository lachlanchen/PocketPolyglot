  "units": [
    {
      "paragraph_id": "kinkakuji-p00454",
      "unit_index": 1,
      "source_text": "我又踩了踩。",
      "en": [
        {
          "t": "I stepped on it again.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00454",
      "unit_index": 2,
      "source_text": "再跌时，第一次跌下去的不舒服的感觉，竟变成了一种勃发的喜悦。",
      "en": [
        {
          "t": "When I fell again, the unpleasant feeling from that first fall unexpectedly changed into a surging joy.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00454",
      "unit_index": 3,
      "source_text": "我想，这是女人的腹部。",
      "en": [
        {
          "t": "I thought, this is a woman's belly.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00454",
      "unit_index": 4,
      "source_text": "这是女人的胸脯。",
      "en": [
        {
          "t": "This is a woman's breast.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00454",
      "unit_index": 5,
      "source_text": "他人的肉体竟像皮球似的，以如此憨厚的弹力做出了反应。",
      "en": [
        {
          "t": "Another person's body, like a rubber ball, had unexpectedly responded with such simple, honest elasticity.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00454",
      "unit_index": 6,
      "source_text": "这是出乎我的想像之外的。",
      "en": [
        {
          "t": "This was beyond anything I had imagined.",
          "g": "predicate"
        }
      ]
    }
  ]
}
