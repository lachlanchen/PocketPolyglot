    {
      "paragraph_id": "kinkakuji-p00359",
      "unit_index": 1,
      "source_text": "它超脱我的心象，不！",
      "en": [
        {
          "t": "It transcended the image in my mind, no!",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00359",
      "unit_index": 2,
      "source_text": "也超脱现实的世界，无缘于任何种类的容易的变化，",
      "en": [
        {
          "t": "It also transcended the real world and had nothing to do with any kind of easy change,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00359",
      "unit_index": 3,
      "source_text": "金阁从未曾显示过这样坚固的美！",
      "en": [
        {
          "t": "The Golden Pavilion had never revealed such solid beauty before!",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00359",
      "unit_index": 4,
      "source_text": "它拒绝所有的意义，",
      "en": [
        {
          "t": "It rejected every meaning,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kinkakuji-p00359",
      "unit_index": 5,
      "source_text": "它的美从未曾显示过这样的辉煌。",
      "en": [
        {
          "t": "Its beauty had never shown such radiance before.",
          "g": "predicate"
        }
      ]
    }
  ]
