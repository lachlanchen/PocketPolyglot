  "units": [
    {
      "paragraph_id": "the-old-capital-p01279",
      "unit_index": 1,
      "source_text": "“对吧，千重子。”",
      "en": [
        {
          "t": "Isn't that right, Chieko?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p01279",
      "unit_index": 2,
      "source_text": "母亲向女儿那边翻过身去。",
      "en": [
        {
          "t": "Her mother turned over toward her daughter.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p01279",
      "unit_index": 3,
      "source_text": "千重子睁开眼睛，却没有回答。",
      "en": [
        {
          "t": "Chieko opened her eyes, but did not answer.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p01279",
      "unit_index": 4,
      "source_text": "沉默了好半天。",
      "en": [
        {
          "t": "There was silence for quite a while.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p01279",
      "unit_index": 5,
      "source_text": "千重子把足尖交叠起来，一动也不动。",
      "en": [
        {
          "t": "Chieko crossed the tips of her feet and lay perfectly still.",
          "g": "predicate"
        }
      ]
    }
  ]
