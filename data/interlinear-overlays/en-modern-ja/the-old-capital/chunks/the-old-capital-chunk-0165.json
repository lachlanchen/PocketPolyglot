  "units": [
    {
      "paragraph_id": "the-old-capital-p00165",
      "unit_index": 1,
      "source_text": "路程很远。",
      "en": [
        {
          "t": "It was a long way.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p00165",
      "unit_index": 2,
      "source_text": "但是他们俩躲开电车道，从南禅寺那边绕远路走，",
      "en": [
        {
          "t": "But the two of them avoided the streetcar road and took a long way around from the Nanzenji side,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p00165",
      "unit_index": 3,
      "source_text": "穿越知恩院后面，通过圆山公园，踏着幽雅的小路，",
      "en": [
        {
          "t": "passing behind Chion-in, going through Maruyama Park, and walking along the graceful little paths,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p00165",
      "unit_index": 4,
      "source_text": "来到清水寺跟前。",
      "en": [
        {
          "t": "until they came to the front of Kiyomizu-dera.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p00165",
      "unit_index": 5,
      "source_text": "这时候，恰好天空披上了一层春天的晚霞。",
      "en": [
        {
          "t": "Just then, the sky happened to be wrapped in a layer of spring evening glow.",
          "g": "predicate"
        }
      ]
    }
  ]
