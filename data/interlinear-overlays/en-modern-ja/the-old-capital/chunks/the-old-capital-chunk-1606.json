      "paragraph_id": "the-old-capital-p01606",
      "unit_index": 1,
      "source_text": "“妈，我上北山杉村去了。",
      "en": [
        {
          "t": "“Mother, I went to the Kitayama cedar village.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p01606",
      "unit_index": 2,
      "source_text": "在那里，住着我的姐妹……",
      "en": [
        {
          "t": "My sister lives there...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p01606",
      "unit_index": 3,
      "source_text": "不知是姐姐还是妹妹，总之我们俩是双胞胎。",
      "en": [
        {
          "t": "I do not know whether she is my older sister or my younger sister, but in any case the two of us are twins.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p01606",
      "unit_index": 4,
      "source_text": "在今年的祇园节上，我们第一次见面。",
      "en": [
        {
          "t": "At this year's Gion Festival, we met for the first time.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p01606",
      "unit_index": 5,
      "source_text": "据说我的生身父母早就不在人世了。”",
      "en": [
        {
          "t": "I hear that my birth parents passed away long ago.”",
          "g": "predicate"
        }
      ]
    }
  ]
