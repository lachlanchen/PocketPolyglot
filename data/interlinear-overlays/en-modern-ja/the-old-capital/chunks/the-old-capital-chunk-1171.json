  "book_id": "the-old-capital",
  "chunk_id": "the-old-capital-chunk-1171",
  "units": [
    {
      "paragraph_id": "the-old-capital-p01171",
      "unit_index": 1,
      "source_text": "千重子过去只是偶尔听到邻居交头接耳说过自己是个弃儿。",
      "en": [
        {
          "t": "Chieko had only occasionally heard the neighbors whispering that she was an abandoned child.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p01171",
      "unit_index": 2,
      "source_text": "自己也这样想过。",
      "en": [
        {
          "t": "She herself had thought so too.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p01171",
      "unit_index": 3,
      "source_text": "不过，父母是什么人，又在什么地方把自己扔掉的呢？",
      "en": [
        {
          "t": "But who were her parents, and where had they abandoned her?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p01171",
      "unit_index": 4,
      "source_text": "这点她尽量不去想。",
      "en": [
        {
          "t": "She tried as much as possible not to think about that.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p01171",
      "unit_index": 5,
      "source_text": "即使想，也不会有结果。",
      "en": [
        {
          "t": "Even if she thought about it, it would lead nowhere.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p01171",
      "unit_index": 6,
      "source_text": "何况太吉郎和阿繁对她的爱是那么深，使她觉得没有必要去想。",
      "en": [
        {
          "t": "Besides, Taichiro and Shige loved her so deeply that she felt no need to think about it.",
          "g": "predicate"
        }
      ]
    }
  ]
}
