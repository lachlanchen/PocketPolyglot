  "units": [
    {
      "paragraph_id": "the-old-capital-p02785",
      "unit_index": 1,
      "source_text": "这场雷阵雨很快就过去了。",
      "en": [
        {
          "t": "This thunderstorm soon passed.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p02785",
      "unit_index": 2,
      "source_text": "半山腰上，雾霭缭绕。",
      "en": [
        {
          "t": "Mist hung around the mountainside.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p02785",
      "unit_index": 3,
      "source_text": "河流下游小田原那边，天空已经放晴。",
      "en": [
        {
          "t": "Downriver toward Odawara, the sky had already cleared.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p02785",
      "unit_index": 4,
      "source_text": "阳光照射在峡谷对面的山上。",
      "en": [
        {
          "t": "Sunlight shone on the mountain across the gorge.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p02785",
      "unit_index": 5,
      "source_text": "蝉儿鸣叫。",
      "en": [
        {
          "t": "The cicadas were singing.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p02785",
      "unit_index": 6,
      "source_text": "廊道上的玻璃门打开了。",
      "en": [
        {
          "t": "The glass door on the corridor opened.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p02785",
      "unit_index": 7,
      "source_text": "七段下黑73时，四只小黑狗已在草坪上玩耍了。",
      "en": [
        {
          "t": "When the seventh-dan player placed Black 73, four little black dogs were already playing on the lawn.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p02785",
      "unit_index": 8,
      "source_text": "过了一会儿，天空又变成半阴半晴。",
      "en": [
        {
          "t": "After a while, the sky turned half cloudy and half clear again.",
          "g": "predicate"
        }
      ]
    }
