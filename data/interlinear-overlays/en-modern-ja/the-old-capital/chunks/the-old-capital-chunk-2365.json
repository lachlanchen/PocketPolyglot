  "units": [
    {
      "paragraph_id": "the-old-capital-p02365",
      "unit_index": 1,
      "source_text": "“小姐。",
      "en": [
        {
          "t": "Miss.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p02365",
      "unit_index": 2,
      "source_text": "现在你我之间的生活方式不同，教养也不一样，",
      "en": [
        {
          "t": "Now you and I live in different ways, and our upbringings are different too,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p02365",
      "unit_index": 3,
      "source_text": "我也过不惯大城市生活，",
      "en": [
        {
          "t": "and I cannot get used to life in a big city,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p02365",
      "unit_index": 4,
      "source_text": "我只要上你店来一次，只要一次也就行了。",
      "en": [
        {
          "t": "I only want to come to your shop once; just once would be enough.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p02365",
      "unit_index": 5,
      "source_text": "也想让你看看你送给我的和服……",
      "en": [
        {
          "t": "I also want you to see the kimono you gave me...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p02365",
      "unit_index": 6,
      "source_text": "再说，小姐还曾两次光临杉山看我。”",
      "en": [
        {
          "t": "Besides, Miss, you came all the way to Sugiyama twice to see me.",
          "g": "predicate"
        }
      ]
    }
  ]
}
