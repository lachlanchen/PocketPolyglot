    {
      "paragraph_id": "the-old-capital-p01882",
      "unit_index": 1,
      "source_text": "“会理解的。”",
      "en": [
        {
          "t": "She will understand.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p01882",
      "unit_index": 2,
      "source_text": "秀男说，“时代节你会来吧。",
      "en": [
        {
          "t": "Hideo said, \"You will come to the Festival of the Ages, won't you?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p01882",
      "unit_index": 3,
      "source_text": "我希望看到你系上这条腰带。",
      "en": [
        {
          "t": "I want to see you wearing this obi.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p01882",
      "unit_index": 4,
      "source_text": "但是，不邀千重子小姐来。",
      "en": [
        {
          "t": "But do not invite Miss Chieko to come.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p01882",
      "unit_index": 5,
      "source_text": "节日的仪仗队是从御所出发。",
      "en": [
        {
          "t": "The festival procession sets out from the Imperial Palace.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p01882",
      "unit_index": 6,
      "source_text": "我在西蛤御门等你。",
      "en": [
        {
          "t": "I will wait for you at Nishihamaguri Gate.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p01882",
      "unit_index": 7,
      "source_text": "就这样决定下来好吗？”",
      "en": [
        {
          "t": "Shall we decide on that?\"",
          "g": "predicate"
        }
      ]
    }
  ]
