  "units": [
    {
      "paragraph_id": "the-old-capital-p02132",
      "unit_index": 1,
      "source_text": "“千重子，你是我一手喂奶喂大的，我非常疼爱你。",
      "en": [
        {
          "t": "“Chieko, I fed you milk with my own hands and raised you, and I love you very dearly.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p02132",
      "unit_index": 2,
      "source_text": "对那姑娘，我也尽量做到一视同仁，不分彼此。",
      "en": [
        {
          "t": "As for that girl, I will also try my best to treat her the same, without making any distinction between you.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p02132",
      "unit_index": 3,
      "source_text": "她长得像你，一定是个好姑娘。",
      "en": [
        {
          "t": "She looks like you, so she must be a good girl.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p02132",
      "unit_index": 4,
      "source_text": "带她来吧。",
      "en": [
        {
          "t": "Bring her here.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p02132",
      "unit_index": 5,
      "source_text": "二十年前，我讨厌双胞胎，现在倒无所谓了。”",
      "en": [
        {
          "t": "Twenty years ago, I disliked twins, but now it does not matter to me anymore.”",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p02132",
      "unit_index": 6,
      "source_text": "父亲说。",
      "en": [
        {
          "t": "Father said.",
          "g": "predicate"
        }
      ]
    }
  ]
}
