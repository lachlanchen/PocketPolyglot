      "paragraph_id": "the-old-capital-p01969",
      "unit_index": 1,
      "source_text": "“这主意不是我出的。",
      "en": [
        {
          "t": "This idea did not come from me.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p01969",
