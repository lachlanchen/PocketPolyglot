  "units": [
    {
      "paragraph_id": "the-old-capital-p01822",
      "unit_index": 1,
      "source_text": "“唔，我是讲过啦。”",
      "en": [
        {
          "t": "Well, I did say that.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p01822",
      "unit_index": 2,
      "source_text": "宗助还是反复地说，",
      "en": [
        {
          "t": "Sosuke kept repeating,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p01822",
      "unit_index": 3,
      "source_text": "“我是从织布工白手起家，",
      "en": [
        {
          "t": "I started out with nothing as a weaver,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p01822",
      "unit_index": 4,
      "source_text": "好不容易才买到一台高机，",
      "en": [
        {
          "t": "and only after great effort was I able to buy one tall loom,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p01822",
      "unit_index": 5,
      "source_text": "有一半钱还是借来的。",
      "en": [
        {
          "t": "and half the money for it was borrowed.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p01822",
      "unit_index": 6,
      "source_text": "所以每次织好一条腰带就送到佐田先生那儿去；",
      "en": [
        {
          "t": "So every time I finished weaving an obi sash, I would take it to Mr. Sada;",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p01822",
      "unit_index": 7,
      "source_text": "只送一条难为情，",
      "en": [
        {
          "t": "I felt embarrassed bringing only one,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p01822",
      "unit_index": 8,
      "source_text": "总是在夜里悄悄送去……”",
      "en": [
        {
          "t": "so I always delivered it quietly at night...",
          "g": "predicate"
        }
      ]
    }
  ]
}
