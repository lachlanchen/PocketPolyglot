  "units": [
    {
      "paragraph_id": "the-old-capital-p03054",
      "unit_index": 1,
      "source_text": "“把您请来，实在对不起。",
      "en": [
        {
          "t": "I am truly sorry to have asked you to come here.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p03054",
      "unit_index": 2,
      "source_text": "长期以来承蒙先生诸多关照，谢谢了。",
      "en": [
        {
          "t": "Thank you for all the kindness you have shown me over such a long time.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p03054",
      "unit_index": 3,
      "source_text": "我已经决定，无论如何也要放弃这盘棋。",
      "en": [
        {
          "t": "I have already decided that, no matter what, I must give up this game.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p03054",
      "unit_index": 4,
      "source_text": "像这种情形，实在是不能奉陪下去了。”",
      "en": [
        {
          "t": "Under circumstances like these, I simply cannot continue playing with you any longer.”",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "the-old-capital-p03054",
      "unit_index": 5,
      "source_text": "七段断然地说。",
      "en": [
        {
          "t": "The seventh dan said firmly.",
          "g": "predicate"
        }
      ]
    }
  ]
}
