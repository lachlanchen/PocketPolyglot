    {
      "paragraph_id": "kokoro-zh-p00100",
      "unit_index": 1,
      "source_text": "“我可不要别人的孩子，你说是吧。”",
      "en": [
        {
          "t": "I certainly do not want someone else's child, don't you agree?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kokoro-zh-p00100",
      "unit_index": 2,
      "source_text": "夫人又看着我说。",
      "en": [
        {
          "t": "The lady looked at me again and said.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kokoro-zh-p00101",
      "unit_index": 1,
      "source_text": "“孩子什么时候都不会有的。”",
      "en": [
        {
          "t": "We will never have children, no matter when.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kokoro-zh-p00101",
      "unit_index": 2,
      "source_text": "先生说。",
      "en": [
        {
          "t": "Sensei said.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kokoro-zh-p00101",
      "unit_index": 3,
      "source_text": "夫人沉默着。",
      "en": [
        {
          "t": "His wife remained silent.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kokoro-zh-p00102",
      "unit_index": 1,
      "source_text": "“为什么呢？”",
      "en": [
        {
          "t": "Why is that?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kokoro-zh-p00102",
      "unit_index": 2,
      "source_text": "我问道。",
      "en": [
        {
          "t": "I asked.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kokoro-zh-p00103",
      "unit_index": 1,
      "source_text": "“老天爷的惩罚呀。”先生说完，",
      "en": [
        {
          "t": "It is Heaven's punishment, Sensei said, and then",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "kokoro-zh-p00103",
      "unit_index": 2,
      "source_text": "哈哈大笑起来。",
      "en": [
        {
          "t": "he burst into loud laughter.",
          "g": "predicate"
        }
      ]
