{
  "schema_version": 1,
  "task_family": "incremental_english_modern_japanese_overlay",
  "book_id": "rashomon-stories",
  "chunk_id": "rashomon-stories-chunk-0053",
  "units": [
    {
      "paragraph_id": "rashomon-stories-p00053",
      "unit_index": 1,
      "source_text": "这毫无难度。",
      "en": [
        {
          "t": "This was no trouble at all.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p00053",
      "unit_index": 2,
      "source_text": "我跟那对夫妻套近乎，骗他们说，",
      "en": [
        {
          "t": "I struck up a friendly conversation with the couple and deceived them by saying,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p00053",
      "unit_index": 3,
      "source_text": "对面山上发现个古墓，",
      "en": [
        {
          "t": "that an ancient tomb had been found on the mountain opposite,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p00053",
      "unit_index": 4,
      "source_text": "我在那挖出许多大刀和镜子，",
      "en": [
        {
          "t": "that I had dug up many long swords and mirrors there,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p00053",
      "unit_index": 5,
      "source_text": "偷偷埋在山后的竹林里了。",
      "en": [
        {
          "t": "and had secretly buried them in the bamboo grove behind the mountain.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p00053",
      "unit_index": 6,
      "source_text": "要是有人想买，给钱就卖。",
      "en": [
        {
          "t": "If anyone wanted to buy them, I would sell them for money.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p00053",
      "unit_index": 7,
      "source_text": "——那个男人被我的谎言撬动了心。",
      "en": [
        {
          "t": "That man had his heart stirred by my lie.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p00053",
      "unit_index": 8,
      "source_text": "——你瞅瞅，贪恋多可恶啊！",
      "en": [
        {
          "t": "Just look how hateful greed can be!",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p00053",
      "unit_index": 9,
      "source_text": "也就不到半小时，他们夫妻就跟我进了山。",
      "en": [
        {
          "t": "In less than half an hour, the husband and wife followed me into the mountain.",
          "g": "predicate"
        }
      ]
    }
  ]
}
