  "book_id": "rashomon-stories",
  "chunk_id": "rashomon-stories-chunk-1143",
  "units": [
    {
      "paragraph_id": "rashomon-stories-p01143",
      "unit_index": 1,
      "source_text": "“我不能爱我的父母吗？",
      "en": [
        {
          "t": "Can I not love my parents?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p01143",
      "unit_index": 2,
      "source_text": "不是的，不是不能爱。",
      "en": [
        {
          "t": "No, it is not that I cannot love them.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p01143",
      "unit_index": 3,
      "source_text": "我虽然爱父亲的人，但是却不爱父母的样貌。",
      "en": [
        {
          "t": "Although I love my father as a person, I do not love my parents' appearance.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p01143",
      "unit_index": 4,
      "source_text": "以貌取人，对君子来说是耻辱。",
      "en": [
        {
          "t": "Judging people by their looks is a disgrace for a gentleman.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p01143",
      "unit_index": 5,
      "source_text": "更何况父亲的外貌呢？",
      "en": [
        {
          "t": "How much more so when it is my father's appearance?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p01143",
      "unit_index": 6,
      "source_text": "可是，无论如何，我还是无法爱父母的外貌。”",
      "en": [
        {
          "t": "And yet, no matter what, I still cannot love my parents' appearance.",
          "g": "predicate"
        }
      ]
    }
  ]
}
