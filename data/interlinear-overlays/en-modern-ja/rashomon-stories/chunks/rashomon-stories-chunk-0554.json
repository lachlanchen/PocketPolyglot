  "units": [
    {
      "paragraph_id": "rashomon-stories-p00554",
      "unit_index": 1,
      "source_text": "“你就别跟我开玩笑啦。",
      "en": [
        {
          "t": "Please do not tease me like that.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p00554",
      "unit_index": 2,
      "source_text": "老爷这么做我才觉得尴尬呢！",
      "en": [
        {
          "t": "When you do that, sir, I am the one who feels embarrassed!",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p00554",
      "unit_index": 3,
      "source_text": "我们也不是外人。",
      "en": [
        {
          "t": "We are not strangers, after all.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p00554",
      "unit_index": 4,
      "source_text": "从老太爷那一代开始，丸佐就备受您家族的照顾呢！",
      "en": [
        {
          "t": "Since the old master's generation, Marusa has received such great kindness from your family!",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p00554",
      "unit_index": 5,
      "source_text": "您千万别这么见外，还请您自己留下来吧。",
      "en": [
        {
          "t": "Please do not stand on ceremony like that; do stay here yourself.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p00554",
      "unit_index": 6,
      "source_text": "呀，小姐。",
      "en": [
        {
          "t": "Oh, young lady.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p00554",
      "unit_index": 7,
      "source_text": "你好！",
      "en": [
        {
          "t": "Good day!",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p00554",
      "unit_index": 8,
      "source_text": "你今天梳的蝴蝶发髻，十分美丽呢！”",
      "en": [
        {
          "t": "The butterfly-style coiffure you are wearing today is very beautiful!",
          "g": "predicate"
        }
      ]
    }
  ]
}
