  "units": [
    {
      "paragraph_id": "rashomon-stories-p00049",
      "unit_index": 1,
      "source_text": "我的确杀了那个男人，但我绝对没杀那女人。",
      "en": [
        {
          "t": "I did kill that man, but I absolutely did not kill the woman.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p00049",
      "unit_index": 2,
      "source_text": "至于她的去向？",
      "en": [
        {
          "t": "As for where she went?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p00049",
      "unit_index": 3,
      "source_text": "鬼才知道。",
      "en": [
        {
          "t": "Who the hell knows?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p00049",
      "unit_index": 4,
      "source_text": "啊，别急。",
      "en": [
        {
          "t": "Ah, do not rush me.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p00049",
      "unit_index": 5,
      "source_text": "再怎么拷问我，不知道就是不知道啊！",
      "en": [
        {
          "t": "No matter how much you torture me, I do not know what I do not know!",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p00049",
      "unit_index": 6,
      "source_text": "而且我既然已经被抓住了，我也没必要掩藏什么了。",
      "en": [
        {
          "t": "And since I have already been caught, there is no need for me to hide anything anymore.",
          "g": "predicate"
        }
      ]
    }
  ]
}
