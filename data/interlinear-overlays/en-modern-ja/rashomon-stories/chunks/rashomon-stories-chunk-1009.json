  "book_id": "rashomon-stories",
  "chunk_id": "rashomon-stories-chunk-1009",
  "units": [
    {
      "paragraph_id": "rashomon-stories-p01009",
      "unit_index": 1,
      "source_text": "“这是圣徒斯特林堡的朋友。",
      "en": [
        {
          "t": "This is a friend of Saint Strindberg.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p01009",
      "unit_index": 2,
      "source_text": "他出身于法国的商人世家，是一个法国画家，",
      "en": [
        {
          "t": "He came from a French merchant family and was a French painter,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p01009",
      "unit_index": 3,
      "source_text": "抛弃了生了一大群孩子的原配，",
      "en": [
        {
          "t": "abandoned his lawful wife, who had borne him a large brood of children,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p01009",
      "unit_index": 4,
      "source_text": "再娶了一个十三四岁的圭蒂姑娘。",
      "en": [
        {
          "t": "and then married a girl named Guiti, only thirteen or fourteen years old.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p01009",
      "unit_index": 5,
      "source_text": "这位圣徒的血管很粗，里面流淌着水手的血液。",
      "en": [
        {
          "t": "This saint has thick blood vessels, and the blood of a sailor flows inside them.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p01009",
      "unit_index": 6,
      "source_text": "再看他那嘴唇，上面留着砒霜什么的之类的痕迹哩。",
      "en": [
        {
          "t": "And look at those lips of his; they bear traces of something like arsenic.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p01009",
      "unit_index": 7,
      "source_text": "第七个神龛里的是……",
      "en": [
        {
          "t": "In the seventh shrine is...",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p01009",
      "unit_index": 8,
      "source_text": "你是不是有些累了。",
      "en": [
        {
          "t": "Are you getting a little tired?",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p01009",
      "unit_index": 9,
      "source_text": "那么，请随我来这边来。”",
      "en": [
        {
          "t": "Then please come this way with me.",
          "g": "predicate"
        }
      ]
    }
  ]
}
