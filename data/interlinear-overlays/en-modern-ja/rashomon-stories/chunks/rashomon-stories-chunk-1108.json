  "units": [
    {
      "paragraph_id": "rashomon-stories-p01108",
      "unit_index": 1,
      "source_text": "那就先不谈这个了。",
      "en": [
        {
          "t": "Let us not talk about that for now.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p01108",
      "unit_index": 2,
      "source_text": "因为一桩事业失败了，我又想回河童国去。",
      "en": [
        {
          "t": "Because one of my undertakings had failed, I wanted to return to the land of the kappa again.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p01108",
      "unit_index": 3,
      "source_text": "是的。",
      "en": [
        {
          "t": "Yes.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p01108",
      "unit_index": 4,
      "source_text": "不是“想去”，而是“想回去”。",
      "en": [
        {
          "t": "It was not that I wanted to go there, but that I wanted to go back.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p01108",
      "unit_index": 5,
      "source_text": "在那时候的我看来，河童国才是我的故乡。",
      "en": [
        {
          "t": "To me at that time, the land of the kappa was truly my homeland.",
          "g": "predicate"
        }
      ]
    }
  ]
}
