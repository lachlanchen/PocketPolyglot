  "units": [
    {
      "paragraph_id": "rashomon-stories-p00656",
      "unit_index": 1,
      "source_text": "“过不下去也得过下去啊。",
      "en": [
        {
          "t": "Even if we cannot get by, we still have to go on living.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p00656",
      "unit_index": 2,
      "source_text": "婆婆啊，你想想，",
      "en": [
        {
          "t": "Mother, think about it,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p00656",
      "unit_index": 3,
      "source_text": "招赘个外人进来，广次会变得很可怜，",
      "en": [
        {
          "t": "if you bring in an outsider as a son-in-law, Hirotsugu will be miserable,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p00656",
      "unit_index": 4,
      "source_text": "你也会心有顾虑，",
      "en": [
        {
          "t": "and you will have misgivings too,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p00656",
      "unit_index": 5,
      "source_text": "那我操的心有过之而无不及呢。”",
      "en": [
        {
          "t": "so I will worry every bit as much, if not more.",
          "g": "predicate"
        }
      ]
    }
  ]
}
