  "units": [
    {
      "paragraph_id": "rashomon-stories-p00171",
      "unit_index": 1,
      "source_text": "“世人都是薄情寡义之徒。",
      "en": [
        {
          "t": "People in this world are all heartless and disloyal.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p00171",
      "unit_index": 2,
      "source_text": "我有钱时，他们捧我、夸我、追随与我，但是我一旦贫穷，",
      "en": [
        {
          "t": "When I had money, they flattered me, praised me, and followed me, but once I became poor,",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p00171",
      "unit_index": 3,
      "source_text": "他们连个好脸色都不肯给我。",
      "en": [
        {
          "t": "they would not even show me a pleasant face.",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p00171",
      "unit_index": 4,
      "source_text": "想到这件事，我就觉得，",
      "en": [
        {
          "t": "When I think about this, I feel that",
          "g": "predicate"
        }
      ]
    },
    {
      "paragraph_id": "rashomon-stories-p00171",
      "unit_index": 5,
      "source_text": "就算我再一次成为大财主，也寡然无味。”",
      "en": [
        {
          "t": "even if I became a very rich man again, it would hold no pleasure for me at all.",
          "g": "predicate"
        }
      ]
    }
  ]
}
